---
// Inner-page hero in the landing look: one screen of drawing paper with the animated tower sketch
// behind a soft veil, a crimson-ruled eyebrow, a Eurostile headline and the landing page's two pill buttons.
import TowerSketch from './landing/TowerSketch.astro';
import { site, telHref, waHref } from '../lib/site';

interface Props {
  eyebrow?: string;
  title: string;
  summary?: string;
  pageName: string;
  waInterest: string;
  buttons?: boolean;
}
const { eyebrow, title, summary, pageName, waInterest, buttons = true } = Astro.props;
---

<section class="page-hero" data-screen>
  <div class="page-hero__sentinel" data-nav-sentinel aria-hidden="true"></div>
  <div class="page-hero__art" aria-hidden="true"><TowerSketch /></div>
  <div class="page-hero__veil" aria-hidden="true"></div>
  <div class="container page-hero__box">
    <div class="page-hero__inner">
      <div class="page-hero__text">
        {
          eyebrow && (
            <p class="page-hero__eyebrow">
              <span class="page-hero__rule" aria-hidden="true" />
              {eyebrow}
            </p>
          )
        }
        <h1 class="page-hero__title">{title}</h1>
        {summary && <p class="page-hero__lead">{summary}</p>}
        {
          buttons && (
            <div class="page-hero__ctas">
              <a class="ph-btn ph-btn--brand" href={waHref(waInterest, pageName)} target="_blank" rel="noopener" data-cta="hero">
                Talk to an expert
                <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
                  <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </a>
              <a class="ph-btn ph-btn--line" href={telHref} data-cta="hero">
                Call <span class="num">{site.phone.display}</span>
              </a>
            </div>
          )
        }
      </div>
      {Astro.slots.has('aside') && <div class="page-hero__aside"><slot name="aside" /></div>}
    </div>
    <slot />
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #fbfaf7;
    color: #0d253d;
  }
  .page-hero__sentinel {
    position: absolute;
    top: 10px;
    left: 0;
    width: 1px;
    height: 1px;
  }
  .page-hero__art {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.75;
  }
  .page-hero__veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(90deg, rgba(251, 250, 247, 0.96) 0%, rgba(251, 250, 247, 0.9) 48%, rgba(251, 250, 247, 0.55) 72%, rgba(251, 250, 247, 0.2) 100%),
      linear-gradient(180deg, rgba(251, 250, 247, 0.85) 0%, rgba(251, 250, 247, 0) 20%);
  }
  .page-hero__box {
    position: relative;
    z-index: 2;
  }
  .page-hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 72px);
    align-items: center;
  }
  .page-hero__inner:not(:has(.page-hero__aside)) {
    grid-template-columns: minmax(0, 1fr);
  }
  .page-hero__text {
    max-width: 760px;
  }
  .page-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 14px;
    margin: 0 0 18px;
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .page-hero__rule {
    width: 40px;
    height: 1px;
    background: currentColor;
    transform-origin: left;
    animation: ph-rule 0.9s 0.2s ease both;
  }
  .page-hero__title {
    margin: 0;
    font-family: var(--font-head);
    font-size: clamp(2.2rem, 1.3rem + 3.2vw, 4rem);
    font-weight: 400;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: #0d253d;
    text-wrap: balance;
    animation: ph-rise 0.9s 0.1s ease both;
  }
  .page-hero__lead {
    max-width: 620px;
    margin: 18px 0 0;
    font-size: clamp(1rem, 0.95rem + 0.3vw, 1.125rem);
    line-height: 1.6;
    color: #4e5d73;
    animation: ph-rise 0.9s 0.25s ease both;
  }
  .page-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: clamp(20px, 4vh, 36px);
    animation: ph-rise 0.9s 0.4s ease both;
  }
  .ph-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 30px;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none !important;
    white-space: nowrap;
    transition: transform 0.2s ease, box-shadow 0.3s ease, background-color 0.3s ease, color 0.3s ease;
  }
  .ph-btn:hover {
    transform: translateY(-2px);
  }
  .ph-btn--brand {
    background: linear-gradient(135deg, #e8104c, #b80f3a);
    color: #fff;
    box-shadow: 0 12px 28px rgba(200, 18, 63, 0.3);
  }
  .ph-btn--brand:hover {
    box-shadow: 0 16px 34px rgba(200, 18, 63, 0.38);
  }
  .ph-btn--line {
    border: 1px solid rgba(13, 37, 61, 0.45);
    background: rgba(255, 255, 255, 0.7);
    color: #0d253d;
  }
  .ph-btn--line:hover {
    border-color: #c8123f;
    color: #c8123f;
  }
  .page-hero__aside {
    animation: ph-rise 0.9s 0.5s ease both;
  }
  /* facts and summaries placed beside the headline read as white plaques */
  .page-hero__aside > :global(*) {
    border: 1px solid rgba(13, 37, 61, 0.08) !important;
    border-radius: 16px !important;
    background: rgba(255, 255, 255, 0.92) !important;
    box-shadow: 0 18px 40px rgba(13, 37, 61, 0.1);
    backdrop-filter: blur(4px);
  }
  .page-hero__aside :global(dt) {
    font-family: var(--font-sans);
    font-size: 0.75rem !important;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #b80f3a !important;
  }
  @keyframes ph-rise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }
  @keyframes ph-rule {
    from {
      transform: scaleX(0);
    }
  }
  @media (max-width: 1023px) {
    .page-hero__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 20px;
    }
    .page-hero__veil {
      background: linear-gradient(180deg, rgba(251, 250, 247, 0.9) 0%, rgba(251, 250, 247, 0.86) 70%, rgba(251, 250, 247, 0.5) 100%);
    }
  }
  /* Phones: text at the top, the whole sketch in the clear lower part (the veil only covers the text) */
  @media (max-width: 767px) {
    .page-hero {
      justify-content: flex-start;
    }
    .page-hero__art {
      top: auto;
      bottom: var(--bar-h, 64px);
      height: 44%;
      opacity: 1;
    }
    .page-hero__veil {
      background: linear-gradient(180deg, rgba(251, 250, 247, 0.92) 0%, rgba(251, 250, 247, 0.92) 50%, rgba(251, 250, 247, 0.4) 62%, rgba(251, 250, 247, 0) 72%);
    }
    .page-hero__title {
      font-size: 2rem;
    }
    .page-hero__lead {
      margin-top: 12px;
      font-size: 0.9375rem;
    }
    .page-hero__ctas {
      margin-top: 18px;
    }
    /* facts beside the headline become a compact 2 × 2 grid */
    .page-hero__aside > :global(dl) {
      grid-template-columns: 1fr 1fr;
    }
    .page-hero__aside :global(dl > div) {
      padding: 10px 12px !important;
      border-top: 0 !important;
    }
    .page-hero__aside :global(dd) {
      font-size: 0.8125rem;
      line-height: 1.35;
    }
    .ph-btn {
      min-height: 46px;
      padding: 0 22px;
      font-size: 0.8125rem;
    }
  }
</style>
