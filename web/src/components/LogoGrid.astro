---
import { Image } from 'astro:assets';
import people from '../data/people.json';
import { img } from '../lib/images';

interface Props {
  /** Columns on desktop (6 full width, 4 in a half-width column) */
  columns?: 4 | 6;
}
const { columns = 6 } = Astro.props;

// Static grid (no auto-scrolling ticker): nothing moves on its own, so there's no pause control
// to provide (WCAG 2.2.2) and every name is visible at once.
const devs = people.developers;
---

<ul role="list" class="logos" style={`--cols:${columns}`} aria-label="Developers we have worked with">
  {
    devs.map((d) => (
      <li class="logos__item">
        <Image src={img(d.logo)} alt={d.name} width={280} loading="lazy" />
      </li>
    ))
  }
</ul>

<style>
  .logos {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 14px;
    margin: 0;
    padding: 0;
  }
  .logos__item {
    display: grid;
    place-items: center;
    height: 84px;
    padding: 12px 16px;
    border: 1px solid rgba(13, 37, 61, 0.08);
    border-radius: 14px;
    background: #fff;
    box-shadow: 0 6px 16px rgba(13, 37, 61, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  .logos__item:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(13, 37, 61, 0.12);
  }
  .logos__item :global(img) {
    max-height: 50px;
    max-width: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  @media (max-width: 1023px) {
    .logos {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 600px) {
    .logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .logos__item {
      height: 68px;
      padding: 10px 12px;
    }
    .logos__item :global(img) {
      max-height: 36px;
    }
  }
</style>
