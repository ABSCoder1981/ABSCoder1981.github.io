---
import Icon from './Icon.astro';
import { telHref, waHref } from '../lib/site';

interface Props {
  pageName: string;
  waInterest: string;
}
const { pageName, waInterest } = Astro.props;
const wa = waHref(waInterest, pageName);
---

<!-- Desktop: floating WhatsApp button (phones have no contact bar since 2026-10-29: the navbar menu and the pages carry Call / WhatsApp) -->
<a href={wa} class="wa-float" target="_blank" rel="noopener" aria-label="WhatsApp us" data-cta="floating">
  <Icon name="whatsapp" size={28} />
</a>

<style>
  .wa-float {
    position: fixed;
    right: 24px;
    bottom: 24px;
    z-index: 60;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: #25d366; /* WhatsApp brand green */
    color: #fff;
    box-shadow: 0 10px 26px rgba(37, 211, 102, 0.45), 0 2px 6px rgba(13, 37, 61, 0.12);
    transition: opacity 0.2s ease, transform 0.2s ease, background-color 0.2s ease;
  }
  /* Two rings radiating outwards, like the office pins on the map */
  .wa-float::before,
  .wa-float::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 50%;
    background: #25d366;
    animation: wa-ring 2.4s ease-out infinite;
  }
  .wa-float::after {
    animation-delay: 1.2s;
  }
  @keyframes wa-ring {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2.1);
      opacity: 0;
    }
  }
  .wa-float:hover {
    background: #1ebe5d;
    transform: scale(1.06);
  }
  /* Step aside while an enquiry form is on screen (it has its own WhatsApp option) */
  :global(html.form-in-view) .wa-float {
    opacity: 0;
    transform: translateY(12px);
    pointer-events: none;
  }
  @media (max-width: 767px) {
    .wa-float {
      display: none;
    }
  }
</style>

<script>
  const root = document.documentElement;
  const isField = (el: EventTarget | null) =>
    el instanceof HTMLElement && el.matches('input:not([type=radio]):not([type=checkbox]), textarea, select');

  document.addEventListener('focusin', (e) => {
    if (isField(e.target)) root.classList.add('is-typing');
  });
  document.addEventListener('focusout', () => {
    // Wait a tick: focus may be moving straight to the next field
    setTimeout(() => {
      if (!isField(document.activeElement)) root.classList.remove('is-typing');
    }, 50);
  });

  const forms = document.querySelectorAll('form');
  if (forms.length && 'IntersectionObserver' in window) {
    const visible = new Set<Element>();
    const io = new IntersectionObserver((entries) => {
      for (const en of entries) en.isIntersecting ? visible.add(en.target) : visible.delete(en.target);
      root.classList.toggle('form-in-view', visible.size > 0);
    });
    forms.forEach((f) => io.observe(f));
  }
</script>
