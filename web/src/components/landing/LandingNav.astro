---
import { Image } from 'astro:assets';
import { localities, telHref, site } from '../../lib/site';
import { img } from '../../lib/images';

// Labels follow the landing-page brief. Ashiyana has no township pages, so TOWNSHIPS lists the six localities.
const townships = localities.map((l) => ({ href: `/${l.slug}`, label: l.name }));
const links = [
  { href: '/projects/sanaswadi-industrial-land', label: 'Projects' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact us' },
];
---

<!--
  Navbar: always position: fixed. Two states, toggled by the .nav--scrolled class:
  A "merged" (scrollY <= 10): transparent, tall, part of the hero.
  B "scrolled": frosted white, shadow, hairline border, compact, smaller logo.
-->
<header class="nav" id="site-nav">
  <div class="nav__inner">
    <a class="nav__brand" href="/">
      <Image src={img('brand/logo.png')} alt="" width={96} height={96} loading="eager" class="nav__logo" />
      <span class="nav__wordmark">
        <span class="nav__name">Ashiyana</span>
        <span class="nav__sub">Real Estate</span>
      </span>
    </a>

    <nav class="nav__menu" aria-label="Main">
      <ul role="list">
        <li class="nav__drop">
          <button type="button" class="nav__link" aria-expanded="false" aria-controls="nav-townships">
            Townships <span class="nav__caret" aria-hidden="true"></span>
          </button>
          <ul role="list" class="nav__panel" id="nav-townships">
            {townships.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
          </ul>
        </li>
        {links.map((l) => <li><a class="nav__link" href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="nav__actions">
      <a class="pill pill--gold" href="/contact" data-cta="nav">Let’s connect</a>
    </div>

    <button type="button" class="nav__burger" aria-expanded="false" aria-controls="nav-mobile" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__mobile" id="nav-mobile" hidden>
    <p class="nav__mobile-h">Townships</p>
    <ul role="list" class="nav__mobile-grid">
      {townships.map((t) => <li><a href={t.href}>{t.label}</a></li>)}
    </ul>
    <ul role="list" class="nav__mobile-list">
      {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
    </ul>
    <div class="nav__mobile-cta">
      <a class="pill pill--gold" href="/contact" data-cta="nav-mobile">Let’s connect</a>
      <a class="pill pill--outline" href={telHref} data-cta="nav-mobile">Call {site.phone.display}</a>
    </div>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    font-family: 'Jost Variable', 'Jost', var(--font-sans);
    background: rgba(255, 255, 255, 0);
    border-bottom: 1px solid transparent;
    box-shadow: none;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease,
      -webkit-backdrop-filter 0.3s ease, backdrop-filter 0.3s ease;
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    max-width: 1320px;
    margin-inline: auto;
    padding: 14px 32px; /* State A: merged with the hero */
    transition: padding 0.3s ease;
  }

  /* ---- State B: scrolled ---- */
  .nav.nav--scrolled {
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
    border-bottom-color: rgba(13, 37, 61, 0.08);
  }
  .nav.nav--scrolled .nav__inner {
    padding-block: 12px;
  }
  .nav.nav--scrolled .nav__logo {
    width: 38px;
    height: 38px;
  }
  .nav.nav--scrolled .nav__name {
    font-size: 1.125rem;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #0d253d;
    text-decoration: none !important;
    flex: none;
  }
  .nav__logo {
    width: 48px;
    height: 48px;
    transition: width 0.3s ease, height 0.3s ease;
  }
  .nav__wordmark {
    display: flex;
    flex-direction: column;
    line-height: 1;
  }
  .nav__name {
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    transition: font-size 0.3s ease;
  }
  .nav__sub {
    margin-top: 4px;
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: #b80f3a;
  }

  .nav__menu {
    margin-left: auto;
  }
  .nav__menu > ul {
    display: flex;
    flex-wrap: nowrap; /* every link stays on one line */
    align-items: center;
    gap: 4px;
    margin: 0;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap; /* "Contact us" / "Townships" never wrap onto a second line */
    color: #0d253d;
    text-decoration: none !important;
    cursor: pointer;
    position: relative;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 8px;
    height: 1px;
    background: #e8104c;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__drop.is-open > .nav__link::after {
    transform: scaleX(1);
  }
  .nav__caret {
    width: 0;
    height: 0;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid currentColor;
    transition: transform 0.3s ease;
  }
  .nav__drop {
    position: relative;
  }
  .nav__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 0;
    min-width: 220px;
    margin: 0;
    padding: 8px;
    background: #fff;
    border: 1px solid rgba(13, 37, 61, 0.08);
    border-radius: 12px;
    box-shadow: 0 16px 40px rgba(13, 37, 61, 0.12);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-6px);
    transition: opacity 0.2s ease, transform 0.2s ease, visibility 0.2s;
  }
  .nav__drop:hover .nav__panel,
  .nav__drop:focus-within .nav__panel,
  .nav__drop.is-open .nav__panel {
    opacity: 1;
    visibility: visible;
    transform: none;
  }
  .nav__drop:hover .nav__caret,
  .nav__drop.is-open .nav__caret {
    transform: rotate(180deg);
  }
  .nav__panel a {
    display: block;
    padding: 10px 12px;
    border-radius: 8px;
    color: #0d253d;
    font-size: 0.9375rem;
    letter-spacing: 0.04em;
    text-decoration: none;
  }
  .nav__panel a:hover {
    background: #fdecf0;
    color: #b80f3a;
  }

  .nav__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  /* Pills */
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 26px;
    border-radius: 9999px;
    font-family: 'Jost Variable', 'Jost', var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none !important;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.3s ease, background-position 0.5s ease, background-color 0.3s ease, color 0.3s ease;
  }
  .pill--gold {
    border: 0;
    color: #fff; /* white on crimson: >= 4.5:1 across the gradient */
    background: linear-gradient(110deg, #e8104c 0%, #c8123f 50%, #9e0c33 100%);
    background-size: 200% 100%;
    background-position: 0% 0;
    box-shadow: 0 6px 18px rgba(200, 18, 63, 0.28);
  }
  .pill--gold:hover {
    background-position: 100% 0;
    box-shadow: 0 10px 24px rgba(200, 18, 63, 0.38);
    transform: translateY(-1px);
  }
  .pill--outline {
    background: transparent;
    color: #0d253d;
    border: 1px solid #0d253d;
  }
  .pill--outline:hover {
    background: #0d253d;
    color: #fff;
  }

  /* Mobile */
  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 48px;
    height: 48px;
    margin-left: auto;
    padding: 0 12px;
    border: 1px solid rgba(13, 37, 61, 0.18);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.6);
    cursor: pointer;
  }
  .nav__burger span {
    display: block;
    height: 1.5px;
    background: #0d253d;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .nav__burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .nav__burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav__burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }
  .nav__mobile {
    max-height: calc(100svh - 72px);
    overflow-y: auto;
    padding: 8px 20px 28px;
    background: #fff;
    border-top: 1px solid rgba(13, 37, 61, 0.08);
  }
  .nav__mobile[hidden] {
    display: none;
  }
  .nav__mobile-h {
    margin: 12px 0 4px;
    font-size: 0.75rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .nav__mobile-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: 16px;
    margin: 0;
  }
  .nav__mobile a:not(.pill) {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid rgba(13, 37, 61, 0.08);
    color: #0d253d;
    text-decoration: none;
  }
  .nav__mobile-list {
    margin: 16px 0 0;
  }
  .nav__mobile-list a {
    font-size: 1.0625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .nav__mobile-cta {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  @media (max-width: 1100px) {
    .nav__inner {
      gap: 16px;
    }
    .nav__link {
      padding: 0 10px;
      letter-spacing: 0.12em;
    }
    .nav__link::after {
      left: 10px;
      right: 10px;
    }
    .nav__actions .pill {
      padding: 0 20px;
      letter-spacing: 0.12em;
    }
    .nav__name {
      font-size: 1.25rem;
    }
  }
  @media (max-width: 991px) {
    .nav__menu,
    .nav__actions {
      display: none;
    }
    .nav__burger {
      display: flex;
    }
    .nav__inner {
      padding: 18px 20px;
    }
    .nav.nav--scrolled .nav__inner {
      padding-block: 10px;
    }
    .nav.is-menu-open {
      background: #fff;
      box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav__inner,
    .nav__logo,
    .nav__name,
    .pill {
      transition: none;
    }
  }
</style>

<script>
  const nav = document.getElementById('site-nav')!;
  const SCROLLED = 'nav--scrolled';
  const setState = (scrolled: boolean) => nav.classList.toggle(SCROLLED, scrolled);

  // Preferred: watch a 1px sentinel placed 10px from the top of the hero. While it is on screen,
  // scrollY <= 10 → "merged". The observer fires once on observe(), so a refresh mid-page
  // immediately shows the correct state.
  const sentinel = document.querySelector('[data-nav-sentinel]');
  if (sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => setState(!entry.isIntersecting), { threshold: 0 }).observe(sentinel);
  } else {
    // Fallback: passive scroll listener throttled with requestAnimationFrame
    let ticking = false;
    const check = () => {
      setState(window.scrollY > 10);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(check);
        }
      },
      { passive: true },
    );
    check();
  }

  // TOWNSHIPS dropdown: hover/focus via CSS; click toggles for touch + keyboard; Escape closes
  const drop = nav.querySelector<HTMLElement>('.nav__drop')!;
  const dropBtn = drop.querySelector('button')!;
  const closeDrop = () => {
    drop.classList.remove('is-open');
    dropBtn.setAttribute('aria-expanded', 'false');
  };
  dropBtn.addEventListener('click', () => {
    const open = !drop.classList.contains('is-open');
    drop.classList.toggle('is-open', open);
    dropBtn.setAttribute('aria-expanded', String(open));
  });
  drop.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      closeDrop();
      dropBtn.focus();
    }
  });
  document.addEventListener('click', (e) => {
    if (!drop.contains(e.target as Node)) closeDrop();
  });

  // Mobile menu
  const burger = nav.querySelector<HTMLButtonElement>('.nav__burger')!;
  const panel = document.getElementById('nav-mobile')!;
  const setMenu = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.hidden = !open;
    nav.classList.toggle('is-menu-open', open);
  };
  burger.addEventListener('click', () => setMenu(panel.hidden));
  panel.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !panel.hidden) {
      setMenu(false);
      burger.focus();
    }
  });
</script>
