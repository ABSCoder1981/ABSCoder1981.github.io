---
import { Image } from 'astro:assets';
import { telHref, site } from '../../lib/site';
import { img } from '../../lib/images';

const links = [
  { href: '/services', label: 'Services' },
  { href: '/careers', label: 'Careers' },
  { href: '/contact', label: 'Contact us' },
];
// the current section is marked (a service page counts as Services)
const path = Astro.url.pathname.replace(/\.html$/, '');
const isCurrent = (href: string) => path === href || path.startsWith(href + '/');
---

<!--
  Navbar: always position: fixed. Two states, toggled by the .nav--scrolled class:
  A "merged" (scrollY <= 10): transparent, tall, part of the hero.
  B "scrolled": frosted white, shadow, hairline border, compact, smaller logo.
-->
<header class="nav" id="site-nav">
  <div class="nav__inner">
    <a class="nav__brand" href="/">
      <Image src={img('brand/logo-stacked.png')} alt="Ashiyana Real Estate" height={128} loading="eager" class="nav__logo" />
    </a>

    <nav class="nav__menu" aria-label="Main">
      <ul role="list">
        {
          links.map((l) => (
            <li>
              <a class="nav__link" href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="nav__actions">
      <a class="pill pill--gold" href="/contact" data-cta="nav">Let’s connect</a>
    </div>

    <button type="button" class="nav__burger" aria-expanded="false" aria-controls="nav-mobile" aria-label="Open menu">
      <span></span><span></span><span></span>
    </button>
  </div>

  <div class="nav__mobile" id="nav-mobile" hidden>
    <ul role="list" class="nav__mobile-list">
      {links.map((l, i) => <li style={`--i:${i}`}><a href={l.href} aria-current={isCurrent(l.href) ? 'page' : undefined}>{l.label}</a></li>)}
    </ul>
    <div class="nav__mobile-cta" style={`--i:${links.length}`}>
      <a class="pill pill--gold" href="/contact" data-cta="nav-mobile">Let’s connect</a>
      <a class="pill pill--outline" href={telHref} data-cta="nav-mobile">Call {site.phone.display}</a>
    </div>
  </div>
</header>
<!-- dims the page behind the open menu drawer; a tap on it closes the menu -->
<div class="nav-scrim" data-nav-scrim aria-hidden="true"></div>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 1000;
    font-family: var(--font-sans);
    background: rgba(255, 255, 255, 0);
    border-bottom: 1px solid transparent;
    box-shadow: none;
    transition: background-color 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease,
      -webkit-backdrop-filter 0.3s ease, backdrop-filter 0.3s ease;
  }
  .nav__inner {
    display: flex;
    align-items: center;
    gap: 32px;
    max-width: 1320px;
    margin-inline: auto;
    padding: 14px 32px; /* State A: merged with the hero */
    transition: padding 0.3s ease;
  }

  /* ---- State B: scrolled ---- */
  .nav.nav--scrolled {
    background: rgba(255, 255, 255, 0.82);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    box-shadow: 0 2px 20px rgba(0, 0, 0, 0.06);
    border-bottom-color: rgba(13, 37, 61, 0.08);
  }
  .nav.nav--scrolled .nav__inner {
    padding-block: 12px;
  }
  .nav.nav--scrolled .nav__logo {
    height: 44px;
  }

  .nav__brand {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #0d253d;
    text-decoration: none !important;
    flex: none;
  }
  /* Square logo (icon above the ASHIYANA / REAL ESTATE lettering) */
  .nav__logo {
    width: auto;
    height: 64px;
    transition: height 0.3s ease;
  }

  .nav__menu {
    margin-left: auto;
  }
  .nav__menu > ul {
    display: flex;
    flex-wrap: nowrap; /* every link stays on one line */
    align-items: center;
    gap: 4px;
    margin: 0;
  }
  .nav__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap; /* "Contact us" / "Townships" never wrap onto a second line */
    color: #0d253d;
    text-decoration: none !important;
    cursor: pointer;
    position: relative;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 8px;
    height: 1px;
    background: #e8104c;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.3s ease;
  }
  .nav__link:hover::after,
  .nav__link:focus-visible::after,
  .nav__link[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: none;
  }

  /* Pills */
  .pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 0 26px;
    border-radius: 9999px;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-decoration: none !important;
    white-space: nowrap;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.3s ease, background-position 0.5s ease, background-color 0.3s ease, color 0.3s ease;
  }
  .pill--gold {
    border: 0;
    color: #fff; /* white on crimson: >= 4.5:1 across the gradient */
    background: linear-gradient(110deg, #e8104c 0%, #c8123f 50%, #9e0c33 100%);
    background-size: 200% 100%;
    background-position: 0% 0;
    box-shadow: 0 6px 18px rgba(200, 18, 63, 0.28);
  }
  .pill--gold:hover {
    background-position: 100% 0;
    box-shadow: 0 10px 24px rgba(200, 18, 63, 0.38);
    transform: translateY(-1px);
  }
  .pill--outline {
    background: transparent;
    color: #0d253d;
    border: 1px solid #0d253d;
  }
  .pill--outline:hover {
    background: #0d253d;
    color: #fff;
  }

  /* Mobile */
  .nav__burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    width: 48px;
    height: 48px;
    margin-left: auto;
    padding: 0 12px;
    border: 1px solid rgba(13, 37, 61, 0.18);
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.6);
    cursor: pointer;
  }
  .nav__burger span {
    display: block;
    height: 1.5px;
    background: #0d253d;
    transition: transform 0.3s ease, opacity 0.3s ease;
  }
  .nav__burger[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(7.5px) rotate(45deg);
  }
  .nav__burger[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav__burger[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-7.5px) rotate(-45deg);
  }
  /* Phone / tablet menu: a drawer that slides down from under the header (like skylinevillas.in) */
  .nav__mobile {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    max-height: calc(100vh - 100%);
    max-height: calc(100svh - 100%);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 4px 20px 28px;
    background: #fff;
    border-top: 1px solid rgba(13, 37, 61, 0.08);
    box-shadow: 0 24px 40px rgba(13, 37, 61, 0.14);
    /* closed: rolled up behind the header */
    clip-path: inset(0 0 100% 0);
    visibility: hidden;
    transition: clip-path 0.45s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s linear 0.45s;
  }
  .nav.is-menu-open .nav__mobile {
    clip-path: inset(0 0 -60px 0); /* room for the shadow */
    visibility: visible;
    transition: clip-path 0.5s cubic-bezier(0.2, 0.7, 0.2, 1), visibility 0s;
  }
  .nav__mobile[hidden] {
    display: none;
  }
  /* links and buttons follow the drawer down, one after another */
  .nav__mobile-list li,
  .nav__mobile-cta {
    opacity: 0;
    transform: translateY(-10px);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .nav.is-menu-open .nav__mobile-list li,
  .nav.is-menu-open .nav__mobile-cta {
    opacity: 1;
    transform: none;
    transition: opacity 0.4s ease calc(0.12s + var(--i, 0) * 0.06s), transform 0.4s cubic-bezier(0.2, 0.7, 0.2, 1) calc(0.12s + var(--i, 0) * 0.06s);
  }
  .nav-scrim {
    position: fixed;
    inset: 0;
    z-index: 999; /* just under the navbar */
    background: rgba(13, 37, 61, 0.38);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.35s ease, visibility 0s linear 0.35s;
  }
  .nav-scrim.is-on {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.35s ease, visibility 0s;
  }
  @media (min-width: 992px) {
    .nav__mobile,
    .nav-scrim {
      display: none;
    }
  }
  .nav__mobile a:not(.pill) {
    display: flex;
    align-items: center;
    min-height: 48px;
    border-bottom: 1px solid rgba(13, 37, 61, 0.08);
    color: #0d253d;
    text-decoration: none;
  }
  .nav__mobile-list {
    margin: 16px 0 0;
  }
  .nav__mobile-list a {
    font-size: 1.0625rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .nav__mobile-cta {
    display: grid;
    gap: 12px;
    margin-top: 24px;
  }

  @media (max-width: 1100px) {
    .nav__inner {
      gap: 16px;
    }
    .nav__link {
      padding: 0 10px;
      letter-spacing: 0.12em;
    }
    .nav__link::after {
      left: 10px;
      right: 10px;
    }
    .nav__actions .pill {
      padding: 0 20px;
      letter-spacing: 0.12em;
    }
  }
  @media (max-width: 991px) {
    .nav__menu,
    .nav__actions {
      display: none;
    }
    .nav__burger {
      display: flex;
    }
    .nav__inner {
      padding: 18px 20px;
    }
    .nav__logo {
      height: 56px;
    }
    .nav.nav--scrolled .nav__inner {
      padding-block: 10px;
    }
    /* the header turns solid while the drawer is open, so the two read as one panel */
    .nav.is-menu-open {
      background: #fff;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav,
    .nav__inner,
    .nav__logo,
    .pill,
    .nav__mobile,
    .nav.is-menu-open .nav__mobile,
    .nav__mobile-list li,
    .nav__mobile-cta,
    .nav-scrim {
      transition: none !important;
    }
  }
  .nav__link[aria-current='page'] {
    color: #c8123f;
  }
  .nav__mobile-list a[aria-current='page'] {
    color: #c8123f;
  }
  /* menu text in the heading font */
  .nav__link,
  .nav__mobile-list a {
    font-family: var(--font-head);
  }
</style>

<script>
  const nav = document.getElementById('site-nav')!;
  const SCROLLED = 'nav--scrolled';
  const setState = (scrolled: boolean) => nav.classList.toggle(SCROLLED, scrolled);

  // Preferred: watch a 1px sentinel placed 10px from the top of the hero. While it is on screen,
  // scrollY <= 10 → "merged". The observer fires once on observe(), so a refresh mid-page
  // immediately shows the correct state.
  const sentinel = document.querySelector('[data-nav-sentinel]');
  if (sentinel && 'IntersectionObserver' in window) {
    new IntersectionObserver(([entry]) => setState(!entry.isIntersecting), { threshold: 0 }).observe(sentinel);
  } else {
    // Fallback: passive scroll listener throttled with requestAnimationFrame
    let ticking = false;
    const check = () => {
      setState(window.scrollY > 10);
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(check);
        }
      },
      { passive: true },
    );
    check();
  }

  // Mobile menu
  // Mobile menu: a drawer sliding down from the header, the page dimmed and held still behind it.
  // Closes on the X, a tap on the dimmed page, Escape, or choosing a link.
  const burger = nav.querySelector<HTMLButtonElement>('.nav__burger')!;
  const panel = document.getElementById('nav-mobile')!;
  const scrim = document.querySelector<HTMLElement>('[data-nav-scrim]');
  // rendered hidden for no-JS; from here on CSS slides it in and out, and inert keeps it out of reach when closed
  panel.hidden = false;
  panel.inert = true;
  let open = false;
  const setMenu = (next: boolean) => {
    open = next;
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
    panel.inert = !open;
    nav.classList.toggle('is-menu-open', open);
    scrim?.classList.toggle('is-on', open);
    document.documentElement.style.overflow = open ? 'hidden' : '';
  };
  burger.addEventListener('click', () => setMenu(!open));
  scrim?.addEventListener('click', () => setMenu(false));
  panel.addEventListener('click', (e) => {
    if ((e.target as Element).closest('a')) setMenu(false);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && open) {
      setMenu(false);
      burger.focus();
    }
  });
  // turning a phone sideways into the desktop layout closes it
  window.matchMedia('(min-width: 992px)').addEventListener('change', (m) => m.matches && open && setMenu(false));
</script>
