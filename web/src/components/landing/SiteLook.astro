---
// The landing page's visual language applied to the shared inner-page components:
// drawing-paper sections with a faint drafting grid, Eurostile headings with a crimson second half,
// crimson-ruled eyebrows, pill buttons and white "plaque" cards. Rendered only on landing-look pages.
---

<style is:global>
  :root {
    --paper: #fbfaf7;
    --paper-soft: #f6f3ee;
    --grid-line: rgba(61, 74, 92, 0.05);
    --grid-fine: rgba(61, 74, 92, 0.03);
    --font-display: var(--font-sans);
  }
  body {
    background: var(--paper);
  }

  /* ---------- Sections: drawing paper ---------- */
  main > section:not(.hero),
  main > article {
    position: relative;
    background-color: var(--paper);
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px),
      linear-gradient(var(--grid-fine) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-fine) 1px, transparent 1px);
    background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
    border-top: 1px solid rgba(13, 37, 61, 0.06);
  }
  main > section.section--soft {
    background-color: var(--paper-soft);
  }
  main > section.section--cream {
    background-color: #fbf1f3;
  }
  main > section.section--navy {
    background-color: #1d0f16;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 120px 120px;
  }

  /* ---------- Type ---------- */
  :is(.display-xxl, .page-title, .display-xl, .display-lg, .display-md, .heading-lg, .heading-md) {
    font-family: var(--font-head);
  }
  :is(.display-xxl, .page-title, .display-xl) {
    font-weight: 400;
    letter-spacing: -0.015em;
    color: #0d253d;
  }
  .page-title {
    font-size: clamp(2.1rem, 1.3rem + 2.8vw, 3.5rem);
    line-height: 1.08;
  }
  .display-xl {
    font-size: clamp(1.8rem, 1.2rem + 2vw, 2.75rem);
    line-height: 1.1;
  }
  .display-lg,
  .heading-lg,
  .heading-md {
    font-weight: 500;
  }
  /* the second half of a two-tone headline is crimson, as on the landing page */
  .tone-mute {
    font-weight: 600;
    color: #c8123f;
  }
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }
  .section-head--center .eyebrow::after {
    content: '';
    width: 28px;
    height: 1px;
    background: currentColor;
  }
  .section-head {
    margin-bottom: clamp(20px, 4vh, 44px);
  }
  .section-head .lead,
  .lead {
    color: #4e5d73;
  }

  /* ---------- Buttons: the landing page's pills ---------- */
  .btn {
    min-height: 50px;
    padding: 0 26px;
    font-family: var(--font-display);
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: transform 0.2s ease, box-shadow 0.3s ease, background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }
  .btn:hover {
    transform: translateY(-2px);
  }
  .btn--primary {
    background: linear-gradient(135deg, #e8104c, #b80f3a);
    box-shadow: 0 10px 24px rgba(200, 18, 63, 0.28);
  }
  .btn--primary:hover {
    background: linear-gradient(135deg, #c8123f, #8f0b2e);
    box-shadow: 0 14px 30px rgba(200, 18, 63, 0.34);
  }
  .btn--whatsapp {
    box-shadow: 0 10px 24px rgba(15, 122, 64, 0.24);
  }
  .btn--outline {
    border-color: rgba(13, 37, 61, 0.4);
    background: rgba(255, 255, 255, 0.6);
    color: #0d253d;
  }
  .btn--outline:hover {
    border-color: #c8123f;
    background: #fff;
    color: #c8123f;
  }
  .text-link {
    font-family: var(--font-display);
    font-weight: 600;
    color: #b80f3a;
  }

  /* ---------- Cards and lists: white plaques on the paper ---------- */
  .card {
    border: 1px solid rgba(13, 37, 61, 0.08);
    border-radius: 16px;
    background: #fff;
    box-shadow: 0 6px 16px rgba(13, 37, 61, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }
  a.card:hover,
  .card:has(a:hover) {
    transform: translateY(-4px);
    box-shadow: 0 14px 28px rgba(13, 37, 61, 0.12);
  }
  .rows > li {
    border-color: rgba(13, 37, 61, 0.1);
  }
  .icon-badge {
    background: #fdecf0;
    color: #c8123f;
  }
  .check-list svg {
    color: #c8123f;
  }
  main table {
    border-radius: 16px !important;
    box-shadow: 0 6px 16px rgba(13, 37, 61, 0.05);
  }
  main th {
    font-family: var(--font-display);
    background: #fdf6f8 !important;
    color: #b80f3a !important;
  }

  /* ---------- Breadcrumbs sit on the first screen, just under the navbar ---------- */
  main {
    position: relative;
  }
  main > .crumbs {
    position: absolute !important;
    top: 98px;
    left: 0;
    right: 0;
    z-index: 4;
    padding-top: 0 !important;
    font-family: var(--font-display);
    letter-spacing: 0.04em;
  }
  main > .crumbs + :is(section, article) {
    padding-top: calc(var(--nav-h) + 76px) !important;
  }
  @media (max-width: 767px) {
    main > .crumbs {
      top: 96px;
    }
    main > .crumbs + :is(section, article) {
      padding-top: calc(var(--nav-h) + 74px) !important;
    }
  }

  /* ---------- Long text (privacy, terms): a readable column ---------- */
  main > article .prose {
    max-width: 780px;
  }
  .prose h2 {
    font-family: var(--font-head);
    font-weight: 500;
    color: #0d253d;
  }

  /* ===== One-screen compaction for the shared inner-page sections ===== */
  /* Wall of happiness: two rows of six */
  main .wall {
    grid-template-columns: repeat(6, minmax(0, 1fr)) !important;
  }
  main .wall .wall__item--wide {
    grid-column: span 2;
  }
  /* Sanaswadi photos: large aerial view beside a column of three */
  main .gallery {
    display: grid !important;
    grid-template-columns: minmax(0, 2.3fr) minmax(0, 1fr) !important;
    grid-auto-rows: auto;
    gap: 12px !important;
  }
  main .gallery > figure {
    margin: 0;
    grid-column: 2;
  }
  main .gallery > .gallery__lead {
    grid-column: 1;
    grid-row: 1 / span 3;
  }
  main .gallery img {
    width: 100%;
    height: calc((100svh - 330px) / 3 - 22px);
    min-height: 70px;
    object-fit: cover;
    border-radius: 12px;
  }
  main .gallery > .gallery__lead img {
    height: calc(100svh - 330px);
  }
  main .gallery figcaption {
    margin-top: 4px;
    font-size: 0.75rem;
  }

  @media (max-height: 820px) {
    main :is(.svc__points, .svc__unsure) {
      display: none !important;
    }
    main .section-head {
      margin-bottom: 16px !important;
    }
  }
  @media (max-height: 700px) {
    main .enquiry :is(.enquiry__points, .lead) {
      display: none !important;
    }
    main .contact__row {
      min-height: 50px !important;
      padding-block: 6px !important;
    }
    main .contact .lead {
      margin-top: 8px !important;
    }
    main .nf__links {
      margin-top: 16px !important;
    }
  }

  /* Phones */
  @media (max-width: 767px) {
    main .section-head {
      margin-bottom: 14px !important;
    }
    main .section-head .lead,
    main .enquiry :is(.eyebrow, .lead, .enquiry__points) {
      display: none !important;
    }
    /* team: a swipe row */
    main .grid:has(> .team-card) {
      display: flex !important;
      gap: 12px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 6px;
    }
    main .grid > .team-card {
      flex: 0 0 58%;
      scroll-snap-align: start;
    }
    main .team-card__bio {
      display: none !important;
    }
    /* logos: four small plaques per row */
    main .logos {
      grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
      gap: 8px !important;
    }
    main .logos__item {
      height: 54px !important;
      padding: 6px 8px !important;
    }
    main .logos__item img {
      max-height: 30px !important;
    }
    main .wall {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
      gap: 6px !important;
    }
    main .wall .wall__item--wide {
      grid-column: span 1;
      aspect-ratio: 4 / 3 !important;
    }
    main .wall > :nth-child(n + 10) {
      display: none !important;
    }
    /* about: the story keeps its quote and signature */
    main .story .prose > p:not(.sign) {
      display: none !important;
    }
    main .story :is(img, picture) {
      max-width: 140px !important;
    }
    /* locality: the office map is in the footer and on Contact */
    main [aria-labelledby='about-h'] aside {
      display: none !important;
    }
    main .svc :is(.svc__summary, .svc__text) {
      display: none !important;
    }
    main .contact .lead {
      display: none !important;
    }
    main .contact__row:nth-child(n + 3) {
      display: none !important;
    }
    main .gallery {
      grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    }
    main .gallery > figure {
      grid-column: auto;
    }
    main .gallery > .gallery__lead {
      grid-column: 1 / -1;
      grid-row: auto;
    }
    main .gallery img {
      height: 18svh;
    }
    main .gallery > .gallery__lead img {
      height: 30svh;
    }
    main .gallery figcaption {
      display: none;
    }
  }

  /* call-back forms on short screens and phones */
  @media (max-height: 700px), (max-width: 767px) {
    main .ef:not(.ef--sheet) .ef__sub {
      display: none !important;
    }
    main .ef:not(.ef--sheet) textarea {
      min-height: 44px !important;
      height: 44px;
    }
    main .ef:not(.ef--sheet) .ef__grid {
      gap: 10px 14px !important;
    }
    main .ef:not(.ef--sheet) .ef__submit {
      margin-top: 10px !important;
    }
  }
  @media (max-width: 767px) {
    main .ef:not(.ef--sheet) .ef__field.ef__full:has(textarea) {
      display: none !important;
    }
    main .contact__list,
    main :is(.svc__points, .svc__unsure),
    main .loc :is(.loc__text, .loc__facts) {
      display: none !important;
    }
  }
  @media (max-height: 640px) {
    main .svc .svc__summary {
      display: none !important;
    }
  }
</style>
