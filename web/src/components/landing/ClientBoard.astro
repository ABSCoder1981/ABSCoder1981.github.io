---
// Section 7 — "The Handover Board" (option B).
// Real handover photos, all pinned like prints on a site-office board at once; hovering a print
// (tapping, on phones) lifts it to the front, enlarged, and clicking it (tapping again) opens the viewer.
// The two written reviews (Priya Sharma, Rajesh Patel) are pinned beside the photos on wide screens.
// Rajesh Kulkarni's review stays in section 02.
// Ratings strip: Google (Kothrud office) as the main badge, Justdial and magicpin as smaller chips.
// "View all photos" / clicking a print opens a full-screen viewer (keyboard + swipe).
import { Picture, getImage } from 'astro:assets';
import { img } from '../../lib/images';
import { site, waHref } from '../../lib/site';
import people from '../../data/people.json';

const reviews = people.reviews.filter((r) => r.name !== 'Rajesh Kulkarni');
const photos = await Promise.all(
  people.wall.map(async (p, i) => {
    const full = await getImage({ src: img(p), width: 1400, format: 'webp' });
    return { key: p, i, full: full.src, tilt: [-2.2, 1.6, -1, 2.4, -1.8, 1.2, -2.6, 1.8, -1.2, 2.2, -1.6][i % 11] };
  }),
);
const ratings = site.ratings.items;
const google = ratings.find((r) => r.primary)!;
const others = ratings.filter((r) => !r.primary);
const wa = waHref('sharing my experience with Ashiyana', 'Landing page · our clients');
const stars = (r: number) => Math.round((r / 5) * 100);
---

<section class="cb" aria-labelledby="cb-h" data-cb data-screen>
  <div class="container">
    <div class="cb__top">
      <header class="cb__head">
        <h2 id="cb-h" class="cb__title">{site.stats.clients} keys handed over. <em>A few of the families.</em></h2>
        <p class="cb__lead">Real handovers, real families, from our Kothrud office and beyond.</p>
      </header>
      <a class="grate" href={google.url} target="_blank" rel="noopener">
        <span class="grate__g" aria-hidden="true">G</span>
        <span class="grate__score num">{google.rating.toFixed(1)}</span>
        <span class="grate__stars" style={`--pct:${stars(google.rating)}%`} aria-hidden="true">★★★★★</span>
        <span class="grate__k">Rated on Google ↗</span>
      </a>
    </div>

    <!-- The board: every photo pinned at once; hovering (or tapping, on phones) brings one to the front, enlarged -->
    <div class="board" data-board>
      <ul role="list" class="board__grid">
        {
          photos.map((p, n) => (
            <li class="pin-item" style={`--t:${p.tilt}deg;--n:${n}`}>
              <button type="button" class="print" data-open={p.i} aria-label={`Open photo ${p.i + 1} of ${photos.length}`}>
                <span class="pinhead" aria-hidden="true" />
                <Picture
                  src={img(p.key)}
                  alt="Ashiyana Real Estate clients and team at a property handover"
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  width={520}
                  widths={[300, 420, 520]}
                  sizes="(max-width: 699px) 70vw, (max-width: 1099px) 40vw, 300px"
                  loading="lazy"
                  class="print__img"
                />
              </button>
            </li>
          ))
        }
      </ul>
      <!-- the two written reviews, pinned beside the photos (wide screens) -->
      <ul role="list" class="board__notes">
        {
          reviews.slice(0, 2).map((r, k) => (
            <li class="pin-item pin-item--note" style={`--t:${k ? -1.6 : 1.8}deg;--n:${photos.length + k}`}>
              <figure class="cnote">
                <span class="pinhead" aria-hidden="true" />
                <p class="cnote__k">Client story · {r.area}</p>
                <blockquote>
                  <p>“{r.quote}”</p>
                </blockquote>
                <figcaption>
                  <strong>{r.name}</strong>
                  <span>{r.label}</span>
                </figcaption>
              </figure>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="cb__btns">
      <button type="button" class="cb__view" data-open="0">View all {photos.length} photos</button>
      <a class="cb__share" href={wa} target="_blank" rel="noopener" data-cta="our-clients">Share your story on WhatsApp <span aria-hidden="true">→</span></a>
    </div>
  </div>

  <!-- Full-screen viewer -->
  <dialog class="viewer" aria-label="Client photos" data-viewer>
    <button type="button" class="viewer__close" data-close aria-label="Close photos">✕</button>
    <button type="button" class="viewer__nav viewer__nav--prev" data-prev aria-label="Previous photo">‹</button>
    <figure class="viewer__fig">
      <img alt="Ashiyana Real Estate clients and team at a property handover" data-viewer-img />
      <figcaption><span data-viewer-count></span></figcaption>
    </figure>
    <button type="button" class="viewer__nav viewer__nav--next" data-next aria-label="Next photo">›</button>
    <script type="application/json" data-viewer-srcs set:html={JSON.stringify(photos.map((p) => p.full))} />
  </dialog>
</section>

<style>
  .cb {
    position: relative;
    padding-block: clamp(44px, 5vw, 72px);
    background-color: #fff;
    background-image:
      linear-gradient(rgba(61, 74, 92, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 74, 92, 0.045) 1px, transparent 1px);
    background-size: 120px 120px;
    border-top: 1px solid rgba(13, 37, 61, 0.06);
    color: #0d253d;
    font-family: var(--font-sans);
  }

  /* ---------- Heading + ratings ---------- */
  .cb__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 24px 48px;
    align-items: end;
  }
  .cb__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .cb__num {
    font-weight: 600;
    color: #0d253d;
  }
  .cb__rule {
    width: 40px;
    height: 1px;
    background: currentColor;
  }
  .cb__title {
    margin: 0;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .cb__title em {
    font-style: normal;
    font-weight: 600;
    color: #c8123f;
  }
  .grate {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    justify-self: end;
    padding: 12px 20px;
    border-radius: 9999px;
    background: #fff;
    border: 1px solid rgba(13, 37, 61, 0.1);
    box-shadow: 0 12px 28px rgba(13, 37, 61, 0.08);
    color: #0d253d;
    text-decoration: none !important;
    transition: transform 0.25s ease;
  }
  .grate:hover {
    transform: translateY(-2px);
  }
  .grate__g {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 2px solid #e3e8ee;
    font-family: var(--font-sans);
    font-weight: 700;
    color: #4285f4;
  }
  .grate__score {
    font-size: 1.5rem;
    font-weight: 600;
  }
  .grate__stars {
    letter-spacing: 2px;
    background: linear-gradient(90deg, #f5a623 var(--pct), #d9dee5 var(--pct));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .grate__k {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #4e5d73;
  }
  .cb__lead {
    margin: 16px 0 0;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    color: #344559;
  }

  .rates {
    display: grid;
    gap: 12px;
    justify-items: end;
  }
  .rate--main {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 18px;
    background: #fff;
    border: 1px solid rgba(13, 37, 61, 0.1);
    box-shadow: 0 14px 34px rgba(13, 37, 61, 0.08);
    color: #0d253d;
    text-decoration: none !important;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }
  .rate--main:hover {
    transform: translateY(-2px);
    box-shadow: 0 18px 40px rgba(13, 37, 61, 0.12);
  }
  .rate__g {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 2px solid #e3e8ee;
    font-family: var(--font-sans);
    font-size: 1.375rem;
    font-weight: 700;
    color: #4285f4;
  }
  .rate__body {
    display: grid;
    gap: 2px;
  }
  .rate__score {
    font-size: 1.75rem;
    font-weight: 600;
    line-height: 1;
  }
  .rate__score small {
    font-size: 0.9375rem;
    font-weight: 500;
    color: #4e5d73;
  }
  /* stars filled to the rating */
  .rate__stars {
    font-size: 1rem;
    letter-spacing: 2px;
    background: linear-gradient(90deg, #f5a623 var(--pct), #d9dee5 var(--pct));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    width: fit-content;
  }
  .rate__meta {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #4e5d73;
  }
  .rate__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 8px;
    margin: 0;
  }
  .rate__chip {
    padding: 6px 12px;
    border-radius: 9999px;
    background: #f6f2f3;
    border: 1px solid rgba(13, 37, 61, 0.08);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #344559;
  }
  .rate__chip strong {
    color: #0d253d;
  }

  /* ---------- The board ---------- */
  .board {
    margin-top: clamp(36px, 5vw, 56px);
    padding: clamp(24px, 3vw, 40px);
    border-radius: 24px;
    background:
      radial-gradient(rgba(13, 37, 61, 0.09) 1px, transparent 1.4px) 0 0 / 14px 14px,
      #f3ece2; /* cork-like board */
    border: 1px solid rgba(13, 37, 61, 0.1);
    box-shadow: inset 0 2px 12px rgba(13, 37, 61, 0.06);
  }
  .board__grid {
    columns: 4 240px;
    column-gap: clamp(18px, 2.4vw, 32px);
    margin: 0;
  }
  .pin-item {
    break-inside: avoid;
    margin-bottom: clamp(22px, 2.6vw, 34px);
    padding-top: 10px;
  }
  .print {
    position: relative;
    display: block;
    width: 100%;
    padding: 10px 10px 30px;
    border: 0;
    background: #fff;
    box-shadow: 0 10px 22px rgba(13, 37, 61, 0.14), 0 2px 4px rgba(13, 37, 61, 0.08);
    transform: rotate(var(--t));
    cursor: zoom-in;
    transition: transform 0.35s ease, box-shadow 0.35s ease;
  }
  .print :global(picture),
  .print :global(.print__img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .print :global(.print__img) {
    filter: saturate(0.8);
    transition: filter 0.35s ease;
  }
  /* lifted print: straightened, enlarged and in front of the others (the script keeps it inside the board) */
  .pin-item {
    position: relative;
    z-index: 1;
  }
  .pin-item.is-lifted {
    z-index: 10;
  }
  .pin-item.is-lifted .print {
    transform: translate(var(--dx, 0px), var(--dy, 0px)) scale(var(--s, 1.8));
    box-shadow: 0 28px 60px rgba(13, 37, 61, 0.32), 0 4px 10px rgba(13, 37, 61, 0.14);
    transition: transform 1s cubic-bezier(0.45, 0, 0.3, 1), box-shadow 1s ease; /* enlarges slowly */
  }
  .pin-item.is-lifted :global(.print__img) {
    filter: none;
  }
  .print:focus-visible {
    outline: 2px solid #c8123f;
    outline-offset: 4px;
  }
  .pinhead {
    position: absolute;
    top: -9px;
    left: 50%;
    width: 18px;
    height: 18px;
    margin-left: -9px;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #ff5c86, #c8123f 60%, #8f0b2e);
    box-shadow: 0 3px 6px rgba(0, 0, 0, 0.25);
    z-index: 1;
  }

  /* review note pinned among the prints */
  .cnote {
    position: relative;
    margin: 0;
    padding: 24px 20px 20px;
    background: #fffdf6;
    border: 1px solid rgba(13, 37, 61, 0.08);
    box-shadow: 0 10px 22px rgba(13, 37, 61, 0.12);
    transform: rotate(var(--t));
    transition: transform 0.35s ease;
  }
  .cnote:hover {
    transform: rotate(0deg) translateY(-4px);
  }
  .cnote__k {
    margin: 0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .cnote blockquote {
    margin: 10px 0 0;
    font-size: 1.125rem;
    line-height: 1.45;
    color: #0d253d;
  }
  .cnote figcaption {
    display: flex;
    flex-direction: column;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px dashed rgba(13, 37, 61, 0.2);
  }
  .cnote strong {
    font-weight: 600;
  }
  .cnote figcaption span {
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: #4e5d73;
  }

  /* buttons */
  .cb__btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 14px 20px;
    margin-top: clamp(28px, 4vw, 40px);
  }
  .cb__view,
  .cb__share {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 24px;
    border-radius: 9999px;
    font: inherit;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none !important;
    cursor: pointer;
    transition: transform 0.2s ease, background-color 0.25s ease, color 0.25s ease;
  }
  .cb__view {
    border: 0;
    background: linear-gradient(110deg, #e8104c 0%, #c8123f 50%, #9e0c33 100%);
    color: #fff;
    box-shadow: 0 10px 24px rgba(200, 18, 63, 0.26);
  }
  .cb__view:hover {
    transform: translateY(-1px);
  }
  .cb__share {
    border: 1px solid rgba(13, 37, 61, 0.25);
    color: #0d253d;
  }
  .cb__share:hover {
    background: #0d253d;
    color: #fff;
  }

  /* ---------- Viewer ---------- */
  .viewer {
    width: 100vw;
    height: 100vh; /* fallback */
    height: 100dvh; /* phones: excludes the browser toolbars, so the buttons stay on screen */
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(15, 8, 12, 0.94);
    color: #fff;
  }
  .viewer[open] {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr) 64px;
    align-items: center;
  }
  .viewer::backdrop {
    background: rgba(0, 0, 0, 0.6);
  }
  .viewer__fig {
    grid-column: 2; /* on phones the arrows float, and the photo would otherwise land in an empty first column */
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 12px;
  }
  .viewer__fig img {
    max-width: 100%;
    max-height: 82vh;
    object-fit: contain;
    border: 8px solid #fff;
  }
  .viewer__fig figcaption {
    font-size: 0.875rem;
    letter-spacing: 0.12em;
    color: #ecd3da;
  }
  .viewer__close,
  .viewer__nav {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.35);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }
  .viewer__nav {
    justify-self: center;
  }
  .viewer__close {
    position: absolute;
    top: 16px;
    right: 16px;
    font-size: 1.125rem;
  }
  .viewer__close:hover,
  .viewer__nav:hover {
    background: #c8123f;
    border-color: #c8123f;
  }

  /* ---------- Motion: prints settle onto the board ---------- */
  @media all {
    .cb__top,
    .board {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .pin-item {
      opacity: 0;
      transform: translateY(-16px);
      transition: opacity 0.6s ease calc(0.2s + var(--n) * 0.06s), transform 0.7s cubic-bezier(0.2, 1.3, 0.4, 1) calc(0.2s + var(--n) * 0.06s);
    }
    .cb.is-in .cb__top,
    .cb.is-in .board,
    .cb.is-in .pin-item {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 899px) {
    .cb__top {
      grid-template-columns: minmax(0, 1fr);
    }
    .rates {
      justify-items: start;
    }
    .rate__chips {
      justify-content: flex-start;
    }
  }
  @media (max-width: 699px) {
    .viewer[open] {
      grid-template-columns: 0 minmax(0, 1fr) 0;
    }
    /* the photo across the full width, clear of the close button and arrows */
    .viewer__fig {
      padding-inline: 8px;
    }
    .viewer__fig img {
      max-height: calc(100vh - 190px); /* fallback */
      max-height: calc(100dvh - 190px);
    }
    .viewer__nav {
      position: absolute;
      bottom: 24px;
    }
    .viewer__nav--prev {
      left: calc(50% - 64px);
    }
    .viewer__nav--next {
      left: calc(50% + 16px);
    }
  }

  /* ===== One-screen compaction ===== */

  /* the board: every print pinned at once, overlapping a little like a real board.
     Wide screens: 6 per row (the last row centred) with the review notes in a column beside them. */
  .board {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) clamp(220px, 22vw, 290px);
    gap: clamp(18px, 2.4vw, 32px);
    align-items: center;
    margin-top: clamp(14px, 2.6vh, 36px);
    padding: clamp(18px, 2.6vh, 30px) clamp(18px, 2.4vw, 32px);
  }
  .board__grid {
    columns: auto;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(10px, 1.6vh, 18px) 0;
    margin: 0;
  }
  .board__grid .pin-item {
    grid-column: span 2;
    margin: 0 -4px; /* neighbouring prints overlap slightly */
    padding-top: 8px;
  }
  .board__grid .pin-item:nth-child(7) {
    grid-column: 2 / span 2; /* 6 on top, 5 below: centre the second row */
  }
  .print {
    padding: 7px 7px 20px;
  }
  .print :global(.print__img) { aspect-ratio: 4 / 3; max-height: calc((100svh - 400px) / 2); object-fit: cover; }
  .board__notes {
    display: grid;
    gap: clamp(14px, 2vh, 22px);
    margin: 0;
  }
  .board__notes .pin-item {
    margin: 0;
    padding-top: 8px;
  }
  .cnote {
    padding: 18px 16px 14px;
  }
  .cnote blockquote { font-size: 0.9375rem; }
  .cnote figcaption {
    margin-top: 10px;
    padding-top: 8px;
  }
  .cb__btns { margin-top: clamp(12px, 2.4vh, 32px); }
  @media (max-width: 899px) {
    /* phones and small tablets: photos only, the notes would not fit one screen */
    .board {
      grid-template-columns: minmax(0, 1fr);
    }
    .board__notes {
      display: none;
    }
  }
  @media (max-width: 699px) {
    .cb__lead, .cb__share { display: none; }
    .cb__title { font-size: 1.8rem; }
    .cb__top { grid-template-columns: minmax(0, 1fr); gap: 10px; }
    .grate { justify-self: start; padding: 8px 14px; }
    /* 3 per row (the last row of 2 centred) */
    .board {
      padding: 16px 14px 18px;
      border-radius: 18px;
    }
    .board__grid {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 10px;
    }
    .board__grid .pin-item:nth-child(7) {
      grid-column: span 2;
    }
    .board__grid .pin-item:nth-child(10) {
      grid-column: 2 / span 2;
    }
    .board__grid .pin-item {
      margin: 0 -2px;
      padding-top: 6px;
    }
    .print {
      padding: 4px 4px 12px;
    }
    .print :global(.print__img) { max-height: none; }
    .pinhead {
      top: -6px;
      width: 12px;
      height: 12px;
      margin-left: -6px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-cb]');
  if (root) {
    if (!('IntersectionObserver' in window)) root.classList.add('is-in');
    else {
      const io = new IntersectionObserver(
        (es) => {
          if (es.some((e) => e.isIntersecting)) {
            root.classList.add('is-in');
            io.disconnect();
          }
        },
        { threshold: 0.12 },
      );
      io.observe(root);
    }

    // Board: hover (mouse), focus (keyboard) or a first tap (touch) lifts a print to the front, enlarged.
    // The shift keeps the enlarged print inside the board, so prints at the edges grow inwards.
    const board = root.querySelector<HTMLElement>('[data-board]')!;
    const items = [...board.querySelectorAll<HTMLElement>('.board__grid .pin-item')];
    let lifted: HTMLElement | null = null;
    const drop = () => {
      lifted?.classList.remove('is-lifted');
      lifted = null;
    };
    const lift = (li: HTMLElement) => {
      if (lifted === li) return;
      drop();
      const r = li.getBoundingClientRect();
      const b = board.getBoundingClientRect();
      const s = Math.min(window.innerWidth < 700 ? 2.4 : 1.9, (b.width - 16) / r.width);
      const half = { w: (r.width * s) / 2, h: (r.height * s) / 2 };
      const cx = r.left + r.width / 2;
      const cy = r.top + r.height / 2;
      const clamp = (v: number, lo: number, hi: number) => Math.min(Math.max(v, lo), Math.max(lo, hi));
      const dx = clamp(cx, b.left + 8 + half.w, b.right - 8 - half.w) - cx;
      const dy = clamp(cy, b.top + 8 + half.h, b.bottom - 8 - half.h) - cy;
      li.style.setProperty('--s', s.toFixed(3));
      li.style.setProperty('--dx', `${dx.toFixed(1)}px`);
      li.style.setProperty('--dy', `${dy.toFixed(1)}px`);
      li.classList.add('is-lifted');
      lifted = li;
    };
    let touch = false;
    for (const li of items) {
      li.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && lift(li));
      li.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && drop());
      li.addEventListener('pointerdown', (e) => (touch = e.pointerType !== 'mouse'));
      const print = li.querySelector<HTMLElement>('.print')!;
      print.addEventListener('focus', () => !touch && lift(li));
      print.addEventListener('blur', () => lifted === li && !touch && drop());
      // touch: the first tap lifts the print, a second tap opens the viewer (capture: runs before it)
      print.addEventListener(
        'click',
        (e) => {
          if (touch && lifted !== li) {
            e.stopImmediatePropagation();
            lift(li);
          }
        },
        true,
      );
    }
    // a tap anywhere else puts the print back
    document.addEventListener('pointerdown', (e) => {
      if (lifted && e.pointerType !== 'mouse' && !lifted.contains(e.target as Node)) drop();
    });
    window.addEventListener('resize', drop);

    // Full-screen viewer
    const dlg = root.querySelector<HTMLDialogElement>('[data-viewer]')!;
    const imgEl = dlg.querySelector<HTMLImageElement>('[data-viewer-img]')!;
    const count = dlg.querySelector<HTMLElement>('[data-viewer-count]')!;
    const srcs: string[] = JSON.parse(dlg.querySelector('[data-viewer-srcs]')!.textContent || '[]');
    let cur = 0;
    let opener: HTMLElement | null = null;
    const show = (i: number) => {
      cur = (i + srcs.length) % srcs.length;
      imgEl.src = srcs[cur];
      count.textContent = `Photo ${cur + 1} of ${srcs.length}`;
    };
    root.querySelectorAll<HTMLElement>('[data-open]').forEach((b) =>
      b.addEventListener('click', () => {
        opener = b;
        show(Number(b.dataset.open));
        dlg.showModal();
      }),
    );
    dlg.querySelector('[data-prev]')!.addEventListener('click', () => show(cur - 1));
    dlg.querySelector('[data-next]')!.addEventListener('click', () => show(cur + 1));
    dlg.querySelector('[data-close]')!.addEventListener('click', () => dlg.close());
    dlg.addEventListener('click', (e) => {
      if (e.target === dlg) dlg.close(); // click on the dark backdrop
    });
    dlg.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(cur + 1);
      else if (e.key === 'ArrowLeft') show(cur - 1);
    });
    dlg.addEventListener('close', () => opener?.focus());
    // swipe
    let x0: number | null = null;
    dlg.addEventListener('pointerdown', (e) => (x0 = e.clientX));
    dlg.addEventListener('pointerup', (e) => {
      if (x0 === null) return;
      const dx = e.clientX - x0;
      if (Math.abs(dx) > 50) show(cur + (dx < 0 ? 1 : -1));
      x0 = null;
    });
  }
</script>
