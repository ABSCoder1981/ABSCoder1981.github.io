---
// One screen per section, shared by every page in the landing look: each section is one viewport
// tall and its content is scaled down slightly to fit (never below 75%); the page scrolls freely and smoothly.
---

<style is:global>
  /* ---------- One screen per section (all devices) ----------
     Each section is exactly one viewport tall, its content starts under the fixed navbar,
     and the page scrolls freely (smoothly, see below). The fit script scales a section's content
     down slightly (never below 75%) if it is still a little too tall for a given screen. */
  :root {
    --nav-h: 68px;
    --bar-h: 0px; /* mobile Call/WhatsApp bar */
  }
  @media (max-width: 767px) {
    :root {
      --bar-h: calc(64px + env(safe-area-inset-bottom));
    }
  }
  html.screens {
    scroll-padding-top: 0;
  }
  :is([data-screen], main > section:not(.hero), main > article) {
    box-sizing: border-box;
    height: 100vh;
    height: 100svh;
    min-height: 0 !important;
    padding: calc(var(--nav-h) + 12px) 0 calc(var(--bar-h) + 12px) !important;
    display: flex;
    flex-direction: column;
    justify-content: center;
    overflow: hidden;
  }
  :is([data-screen], main > section:not(.hero), main > article) > .container {
    width: 100%;
  }
  /* the mobile bar's own body padding is not needed here: sections reserve that space themselves */
  @media (max-width: 767px) {
    html.screens body {
      padding-bottom: 0;
    }
  }
  :is([data-screen], main > section:not(.hero), main > article).is-overfull {
    height: auto;
    min-height: 100svh !important;
  }
</style>

<script>
  // Fit each section's content into one screen (CSS zoom keeps layout, clicks and text crisp).
  const root = document.documentElement;
  root.classList.add('screens');
  // inner pages: every top-level section of <main> is a screen
  for (const el of document.querySelectorAll<HTMLElement>('main > section:not(.hero), main > article')) el.setAttribute('data-screen', '');
  const MIN = 0.75;
  const fitAll = () => {
    for (const sec of document.querySelectorAll<HTMLElement>('[data-screen]')) {
      const box = sec.querySelector<HTMLElement>(':scope > .container');
      if (!box) continue;
      box.style.zoom = '1';
      sec.classList.remove('is-overfull'); // measure against one screen, not a previously grown section
      const cs = getComputedStyle(sec);
      const avail = sec.clientHeight - parseFloat(cs.paddingTop) - parseFloat(cs.paddingBottom);
      const need = box.scrollHeight;
      // On phones every button keeps a 44px+ tap target: a section is never scaled below the point where
      // its smallest button would drop under 44px (forms not at all); if it still doesn't fit, it grows instead.
      let tapMin = 0;
      if (window.innerWidth < 768) {
        if (box.querySelector('form, .btn-row')) tapMin = 1;
        for (const el of box.querySelectorAll<HTMLElement>('a.btn, button, input, select')) {
          if (el.offsetParent !== null && el.offsetHeight > 0) tapMin = Math.max(tapMin, Math.min(1, 44.5 / el.offsetHeight)); // a hair over 44 survives the rounding below
        }
      }
      const z = need > avail ? Math.max(MIN, avail / need, tapMin) : 1;
      box.style.zoom = String(Math.floor(z * 1000) / 1000);
      // still too tall even at the minimum: let this one section grow rather than cut content
      sec.classList.toggle('is-overfull', need * z > avail + 2);
    }
  };
  let t: number | undefined;
  const queue = () => {
    window.clearTimeout(t);
    t = window.setTimeout(fitAll, 120);
  };
  fitAll();
  document.fonts?.ready.then(fitAll);
  // refit when a section changes width (late viewport on phones, images arriving, panels opening)
  if ('ResizeObserver' in window) {
    const widths = new WeakMap<Element, number>();
    const ro = new ResizeObserver((entries) => {
      let changed = false;
      for (const e of entries) {
        const w = Math.round(e.contentRect.width);
        if (widths.get(e.target) !== w) changed = true;
        widths.set(e.target, w);
      }
      if (changed) queue();
    });
    document.querySelectorAll('[data-screen]').forEach((s) => ro.observe(s));
  }
  window.addEventListener('load', fitAll);
  window.addEventListener('resize', queue);
  // content that changes height (tabs, accordions, steppers): refit after its transition
  document.addEventListener('click', () => window.setTimeout(fitAll, 520));
  document.addEventListener('ashiyana:refit', queue);

  // Smooth scrolling: the page scrolls freely (no section snapping) and mouse-wheel / trackpad input
  // glides to its target with easing, like premium sites. Touch, keyboard and the scrollbar stay native;
  // inner scroll areas (lists, sideways rows, dialogs) keep their own scrolling. Off for reduced motion.
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reducedMotion && window.matchMedia('(pointer: fine)').matches) {
    const EASE = 0.09; // share of the remaining distance covered per frame (lower = smoother, longer glide)
    let target = window.scrollY;
    let current = window.scrollY;
    let running = false;
    const maxY = () => document.documentElement.scrollHeight - window.innerHeight;
    const scrollsItself = (el: Element | null, dy: number) => {
      for (; el && el !== document.body && el !== root; el = el.parentElement) {
        if (el.matches('dialog, .nav__mobile')) return true;
        const oy = getComputedStyle(el).overflowY;
        if ((oy === 'auto' || oy === 'scroll') && el.scrollHeight > el.clientHeight + 1) {
          if ((dy > 0 && el.scrollTop + el.clientHeight < el.scrollHeight - 1) || (dy < 0 && el.scrollTop > 0)) return true;
        }
      }
      return false;
    };
    const tick = () => {
      current += (target - current) * EASE;
      if (Math.abs(target - current) < 0.5) current = target;
      window.scrollTo({ top: current, behavior: 'instant' as ScrollBehavior });
      if (current !== target) requestAnimationFrame(tick);
      else running = false;
    };
    window.addEventListener(
      'wheel',
      (e) => {
        if (e.ctrlKey || Math.abs(e.deltaX) > Math.abs(e.deltaY)) return; // pinch-zoom or sideways scroll
        if (scrollsItself(e.target as Element, e.deltaY)) return;
        e.preventDefault();
        const step = e.deltaMode === 1 ? e.deltaY * 40 : e.deltaMode === 2 ? e.deltaY * window.innerHeight : e.deltaY;
        if (!running) target = current = window.scrollY;
        target = Math.max(0, Math.min(maxY(), target + step));
        if (!running) {
          running = true;
          requestAnimationFrame(tick);
        }
      },
      { passive: false },
    );
    // keyboard, scrollbar or link jumps: follow them so the next wheel glide starts from there
    window.addEventListener('scroll', () => {
      if (!running) target = current = window.scrollY;
    }, { passive: true });
  }
</script>


