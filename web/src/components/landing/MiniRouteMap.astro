---
// Phones only: a compact version of the hero's route map (PuneMap's pins and routes need a wide screen).
// Kothrud head office at the bottom centre, routes to each area and to the Baner office. The routes draw in,
// then a dot travels Kothrud → each area in turn (the route turns solid, like hovering a pin on desktop) and
// the matching area chip above lights up. Tapping an area on the map plays its route straight away.
import { localities } from '../../lib/site';

const VB = { w: 400, h: 250 };
const HUB = { x: 200, y: 214 };
// Same directions as the desktop map (west left, east right, north up), squeezed to a phone-wide box
const places: { slug: string; name: string; x: number; y: number; side: 'left' | 'right' }[] = [
  { slug: 'baner', name: 'Baner office', x: 92, y: 22, side: 'left' },
  { slug: 'bavdhan', name: 'Bavdhan', x: 64, y: 78, side: 'left' },
  { slug: 'warje', name: 'Warje', x: 50, y: 160, side: 'left' },
  { slug: 'prabhat-road', name: 'Prabhat Road', x: 336, y: 40, side: 'right' },
  { slug: 'erandwane', name: 'Erandwane', x: 350, y: 100, side: 'right' },
  { slug: 'karvenagar', name: 'Karvenagar', x: 340, y: 164, side: 'right' },
];
const known = new Set(['baner', ...localities.map((l) => l.slug)]);
// Leaves the hub sideways like a road, then bends up to the area (as on the desktop map)
const routeD = (to: { x: number; y: number }, office = false) => {
  const c = office ? { x: 30, y: HUB.y } : { x: HUB.x * 0.35 + to.x * 0.65, y: HUB.y * 0.86 + to.y * 0.14 };
  return `M${HUB.x} ${HUB.y}Q${c.x.toFixed(1)} ${c.y.toFixed(1)} ${to.x} ${to.y}`;
};
const routes = places.filter((p) => known.has(p.slug)).map((p, i) => ({ ...p, i, d: routeD(p, p.slug === 'baner') }));
---

<div class="mr" data-mini-map>
  <svg viewBox={`0 0 ${VB.w} ${VB.h}`} preserveAspectRatio="xMidYMid meet" role="img" aria-label="Map: routes from our Kothrud office to the areas we work in">
    {
      routes.map((r) => (
        <g class:list={['mr-route', { 'mr-route--office': r.slug === 'baner' }]} data-mr={r.slug} style={`--i:${r.i}`}>
          <path class="mr-line" d={r.d} pathLength="1" />
          <path class="mr-trail" d={r.d} pathLength="1" />
          <circle class="mr-lead" r="5.5">
            <animateMotion dur="1.1s" begin="indefinite" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.4 0 0.2 1" path={r.d} />
          </circle>
        </g>
      ))
    }
    {
      routes.map((r) => (
        <g class="mr-node" data-mr-node={r.slug} style={`--i:${r.i}`} role="button" tabindex="0" aria-label={`Show the route from Kothrud to ${r.name}`}>
          <circle class="mr-hit" cx={r.x} cy={r.y} r="22" />
          <circle class="mr-dot" cx={r.x} cy={r.y} r="5" />
          <text x={r.side === 'left' ? r.x + 10 : r.x - 10} y={r.y + 4.5} text-anchor={r.side === 'left' ? 'start' : 'end'}>
            {r.name}
          </text>
        </g>
      ))
    }
    <g class="mr-hub">
      <circle class="mr-hub__pulse" cx={HUB.x} cy={HUB.y} r="7" />
      <circle class="mr-hub__dot" cx={HUB.x} cy={HUB.y} r="7" />
      <text x={HUB.x} y={HUB.y + 26} text-anchor="middle">Kothrud · Head office</text>
    </g>
  </svg>
</div>

<style>
  /* hidden unless the hero's phone layout turns it on */
  .mr {
    display: none;
  }
  @media (max-width: 767px) {
    .mr {
      display: block;
      flex: 1 1 0;
      width: 100%;
      min-height: 150px;
      max-height: 300px;
      margin-top: 10px;
    }
  }
  .mr {
    pointer-events: auto; /* the hero's content wrapper turns clicks off for itself */
  }
  .mr svg {
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  /* routes: dashed, drawn in one after another */
  .mr-line {
    fill: none;
    stroke: #c8123f;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.6;
    animation: mr-draw 1.2s ease calc(1.2s + var(--i) * 0.25s) forwards;
  }
  .mr-route--office .mr-line {
    stroke-width: 2.2;
    opacity: 0.75;
  }
  @keyframes mr-draw {
    99% {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dasharray: 0.018 0.012;
      stroke-dashoffset: 0;
    }
  }
  .mr-route--office .mr-line {
    animation-name: mr-draw-solid;
  }
  @keyframes mr-draw-solid {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* the active route: a solid line follows the dot from Kothrud to the area */
  .mr-trail {
    fill: none;
    stroke: #c8123f;
    stroke-width: 2.8;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .mr-route.is-hot .mr-trail {
    animation: mr-trail 1.1s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes mr-trail {
    to {
      stroke-dashoffset: 0;
    }
  }
  .mr-lead {
    fill: #e8104c;
    stroke: #fff;
    stroke-width: 2;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .mr-route.is-hot .mr-lead {
    opacity: 1;
  }

  /* area dots and names: drop in after their route */
  .mr-node {
    cursor: pointer;
    opacity: 0;
    animation: mr-in 0.5s ease calc(1.8s + var(--i) * 0.25s) forwards;
    outline: none;
  }
  .mr-hit {
    fill: transparent;
  }
  .mr-dot {
    fill: #fff;
    stroke: #e8104c;
    stroke-width: 2.4;
    transition: fill 0.25s ease;
  }
  .mr-node text,
  .mr-hub text {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    fill: #0d253d;
    paint-order: stroke;
    stroke: rgba(251, 250, 247, 0.95);
    stroke-width: 4px;
    stroke-linejoin: round;
  }
  .mr-node.is-hot .mr-dot {
    fill: #e8104c;
  }
  .mr-node.is-hot text {
    fill: #b80f3a;
    font-weight: 600;
  }
  .mr-node:focus-visible .mr-dot {
    stroke-width: 4;
  }

  /* the head office: a filled pulsing dot */
  .mr-hub {
    opacity: 0;
    animation: mr-in 0.5s ease 1s forwards;
  }
  .mr-hub__dot {
    fill: #e8104c;
    stroke: #fff;
    stroke-width: 2.5;
  }
  .mr-hub__pulse {
    fill: #e8104c;
    transform-box: fill-box;
    transform-origin: center;
    animation: mr-pulse 2.4s ease-out 1.6s infinite;
  }
  .mr-hub text {
    font-weight: 600;
    font-size: 12px;
  }
  @keyframes mr-in {
    to {
      opacity: 1;
    }
  }
  @keyframes mr-pulse {
    0% {
      transform: scale(1);
      opacity: 0.6;
    }
    100% {
      transform: scale(2.8);
      opacity: 0;
    }
  }
</style>

<script>
  // Phones: play one route after another, and the one tapped. Pauses while the hero is off-screen.
  const box = document.querySelector<HTMLElement>('[data-mini-map]');
  const phone = window.matchMedia('(max-width: 767px)');
  if (box) {
    const routes = new Map([...box.querySelectorAll<SVGGElement>('[data-mr]')].map((g) => [g.dataset.mr!, g]));
    const nodes = new Map([...box.querySelectorAll<SVGGElement>('[data-mr-node]')].map((g) => [g.dataset.mrNode!, g]));
    const order = ['karvenagar', 'erandwane', 'prabhat-road', 'baner', 'bavdhan', 'warje'].filter((s) => routes.has(s));
    // the area chips above the map (Baner office links to its map, the rest to /<area>)
    const chips = new Map<string, HTMLAnchorElement>();
    for (const a of document.querySelectorAll<HTMLAnchorElement>('.hero__areas a')) {
      const slug = a.getAttribute('href')?.startsWith('/') ? a.getAttribute('href')!.slice(1) : 'baner';
      chips.set(slug, a);
    }

    let current = '';
    let step = -1;
    let timer: number | undefined;
    let visible = true;

    const play = (slug: string) => {
      if (current) {
        routes.get(current)?.classList.remove('is-hot');
        nodes.get(current)?.classList.remove('is-hot');
        chips.get(current)?.classList.remove('is-live');
      }
      const g = routes.get(slug);
      if (!g) return;
      current = slug;
      void g.getBoundingClientRect(); // restart the trail animation
      g.classList.add('is-hot');
      nodes.get(slug)?.classList.add('is-hot');
      g.querySelector<SVGAnimationElement>('animateMotion')?.beginElement();
      const chip = chips.get(slug);
      if (chip) {
        chip.classList.add('is-live');
        const row = chip.closest('ul');
        if (row && row.scrollWidth > row.clientWidth) {
          const c = chip.getBoundingClientRect();
          const r = row.getBoundingClientRect();
          row.scrollTo({ left: row.scrollLeft + (c.left - r.left) - (r.width - c.width) / 2, behavior: 'smooth' });
        }
      }
    };
    const next = () => {
      step = (step + 1) % order.length;
      play(order[step]);
    };
    const schedule = (delay: number) => {
      window.clearTimeout(timer);
      timer = window.setTimeout(function tick() {
        if (visible && !document.hidden && phone.matches) next();
        timer = window.setTimeout(tick, 2800);
      }, delay);
    };

    for (const [slug, node] of nodes) {
      const pick = () => {
        step = order.indexOf(slug);
        play(slug);
        schedule(6000); // let the tapped route be seen before the tour continues
      };
      node.addEventListener('click', pick);
      node.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          pick();
        }
      });
    }
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.2 }).observe(box);
    }
    schedule(3400); // after the routes have drawn in
  }
</script>
