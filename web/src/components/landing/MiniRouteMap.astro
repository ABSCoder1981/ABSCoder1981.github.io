---
// Phones only: the hero's route map, laid out like the desktop map with the headline, description
// and buttons in the middle. Baner, Prabhat Road, Bavdhan and Erandwane sit above the text, Warje
// and Karvenagar below it, and the Kothrud head office at the bottom. West on the left, east on the right.
// The pins are in normal flow (the wrapper is display: contents, so the two bands become hero rows
// around .hero__content); the script measures the pin dots and draws each route from Kothrud.
// The routes draw in, then a dot travels Kothrud → each area in turn (the route turns solid and the
// pin lights up, like hovering a pin on desktop). Pins link to their area pages.
import { localities, site } from '../../lib/site';

const branch = site.offices.find((o) => o.id === 'baner')!;
const area = (slug: string) => {
  const l = localities.find((x) => x.slug === slug)!;
  return { slug, name: l.name, href: `/${slug}`, external: false, office: false };
};
const baner = { slug: 'baner', name: 'Baner', href: branch.mapUrl, external: true, office: true };
// Top band: two rows, west pins on the left, east on the right (in reading order for screen readers)
const top = [
  { ...baner, side: 'left' },
  { ...area('prabhat-road'), side: 'right', indent: true },
  { ...area('bavdhan'), side: 'left', indent: true },
  { ...area('erandwane'), side: 'right' },
];
const bottom = [
  { ...area('warje'), side: 'left' },
  { ...area('karvenagar'), side: 'right' },
];
const pins = [...top, ...bottom].map((p, i) => ({ ...p, i }));
---

<div class="mr" data-mini-map>
  <svg class="mr__svg" aria-hidden="true" focusable="false">
    <!-- faint base: river and highway, as on the desktop map (placed by the script) -->
    <path class="mr-river" data-mr-base="river" />
    <path class="mr-hwy" data-mr-base="hwy" />
    {
      pins.map((p) => (
        <g class:list={['mr-route', { 'mr-route--office': p.office }]} data-mr={p.slug} style={`--i:${p.i}`}>
          <path class="mr-line" id={`mr-path-${p.slug}`} pathLength="1" />
          <path class="mr-trail" pathLength="1" />
          <circle class="mr-lead" r="6">
            <animateMotion dur="1.2s" begin="indefinite" fill="freeze" calcMode="spline" keyTimes="0;1" keySplines="0.4 0 0.2 1">
              <mpath href={`#mr-path-${p.slug}`} />
            </animateMotion>
          </circle>
        </g>
      ))
    }
  </svg>

  <div class="mr__band mr__band--top">
    {
      pins.slice(0, top.length).map((p) => (
        <a
          class:list={['mr-pin', `mr-pin--${p.side}`, { 'mr-pin--office': p.office, 'mr-pin--indent': p.indent }]}
          href={p.href}
          {...(p.external ? { target: '_blank', rel: 'noopener' } : {})}
          data-mr-node={p.slug}
          style={`--i:${p.i}`}
        >
          <span class="mr-pin__dot" aria-hidden="true" />
          <span class="mr-pin__card">{p.name}</span>
        </a>
      ))
    }
  </div>

  <div class="mr__band mr__band--bottom">
    {
      pins.slice(top.length).map((p) => (
        <a class:list={['mr-pin', `mr-pin--${p.side}`]} href={p.href} data-mr-node={p.slug} style={`--i:${p.i}`}>
          <span class="mr-pin__dot" aria-hidden="true" />
          <span class="mr-pin__card">{p.name}</span>
        </a>
      ))
    }
    <a class="mr-pin mr-pin--hub" href="/kothrud" data-mr-hub>
      <span class="mr-pin__dot" aria-hidden="true"><span class="mr-pin__pulse" /></span>
      <span class="mr-pin__card">Kothrud</span>
    </a>
    <p class="mr-caption"><span aria-hidden="true"></span> 2 offices · West Pune</p>
  </div>
</div>

<style>
  /* hidden unless the hero's phone layout turns it on */
  .mr {
    display: none;
  }
  @media (max-width: 767px) {
    /* the svg and the two bands become rows of the hero (top band → text → bottom band) */
    .mr {
      display: contents;
    }
  }
  .mr__svg {
    position: absolute;
    inset: 0;
    z-index: 2;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .mr__band {
    position: relative;
    z-index: 3;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    row-gap: 12px;
    padding-inline: 14px;
  }
  .mr__band--top {
    order: 1;
    padding-top: 100px; /* clears the overlay navbar */
  }
  .mr__band--bottom {
    order: 3;
    padding-bottom: calc(14px + env(safe-area-inset-bottom, 0px));
  }

  /* ---------- base map ---------- */
  .mr-river {
    fill: none;
    stroke: #e8104c;
    stroke-width: 7;
    stroke-linecap: round;
    opacity: 0.07;
  }
  .mr-hwy {
    fill: none;
    stroke: #3d4a5c;
    stroke-width: 5;
    opacity: 0.08;
  }

  /* ---------- routes: dashed, drawn in one after another ---------- */
  .mr-line {
    fill: none;
    stroke: #c8123f;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    opacity: 0.55;
    animation: mr-draw 1.3s ease calc(1s + var(--i) * 0.3s) forwards;
  }
  .mr-route--office .mr-line {
    stroke-width: 2.2;
    opacity: 0.7;
    animation-name: mr-draw-solid;
  }
  @keyframes mr-draw {
    99% {
      stroke-dasharray: 1;
      stroke-dashoffset: 0;
    }
    100% {
      stroke-dasharray: 0.012 0.008;
      stroke-dashoffset: 0;
    }
  }
  @keyframes mr-draw-solid {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* the active route: a solid line follows the dot from Kothrud to the area */
  .mr-trail {
    fill: none;
    stroke: #c8123f;
    stroke-width: 2.6;
    stroke-linecap: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }
  .mr-route.is-hot .mr-trail {
    animation: mr-trail 1.2s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes mr-trail {
    to {
      stroke-dashoffset: 0;
    }
  }
  .mr-lead {
    fill: #e8104c;
    stroke: #fff;
    stroke-width: 2;
    opacity: 0;
    transition: opacity 0.2s ease;
  }
  .mr-route.is-hot .mr-lead {
    opacity: 1;
  }

  /* ---------- pins: dot on the outer edge + white card with the area name ---------- */
  .mr-pin {
    display: flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    text-decoration: none !important;
    color: #0d253d;
    opacity: 0;
    animation: mr-drop 0.6s cubic-bezier(0.2, 1.4, 0.4, 1) calc(1.6s + var(--i, 0) * 0.3s) forwards;
  }
  .mr-pin--left {
    grid-column: 1;
    justify-self: start;
  }
  .mr-pin--right {
    grid-column: 2;
    justify-self: end;
    flex-direction: row-reverse;
  }
  /* a little stagger, so the two pins on a side don't share one route line */
  .mr-pin--left.mr-pin--indent {
    margin-left: 22px;
  }
  .mr-pin--right.mr-pin--indent {
    margin-right: 22px;
  }
  .mr-pin__dot {
    position: relative;
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid #e8104c;
    box-shadow: 0 0 0 5px rgba(232, 16, 76, 0.1);
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }
  .mr-pin__dot::after {
    content: '';
    position: absolute;
    inset: 5px;
    border-radius: 50%;
    background: #e8104c;
  }
  .mr-pin__card {
    padding: 6px 12px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 6px 18px rgba(13, 37, 61, 0.1);
    white-space: nowrap;
    font-family: var(--font-head);
    font-size: 0.9375rem;
    line-height: 1.2;
    transition: box-shadow 0.3s ease;
  }
  .mr-pin--office .mr-pin__card {
    color: #b80f3a;
  }
  /* the pin whose route is playing */
  .mr-pin.is-hot .mr-pin__dot {
    box-shadow: 0 0 0 8px rgba(232, 16, 76, 0.18);
  }
  .mr-pin.is-hot .mr-pin__card {
    color: #b80f3a;
    box-shadow: 0 0 0 1.5px #e8104c, 0 8px 22px rgba(200, 18, 63, 0.18);
  }

  /* Kothrud head office: centred under the side pins, bigger pulsing dot */
  .mr-pin--hub {
    grid-column: 1 / -1;
    justify-self: center;
    margin-top: 2px;
    animation-delay: 0.8s;
  }
  .mr-pin--hub .mr-pin__dot {
    width: 30px;
    height: 30px;
    border-width: 2.5px;
  }
  .mr-pin--hub .mr-pin__dot::after {
    inset: 6px;
  }
  .mr-pin--hub .mr-pin__card {
    color: #b80f3a;
  }
  .mr-pin__pulse {
    position: absolute;
    inset: -2px;
    border-radius: 50%;
    border: 2px solid #e8104c;
    animation: mr-pulse 2.4s ease-out 1.6s infinite;
  }

  .mr-caption {
    grid-column: 1 / -1;
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    padding: 6px 12px;
    border-radius: 9999px;
    background: rgba(255, 255, 255, 0.85);
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: #0d253d;
    opacity: 0;
    animation: mr-in 0.6s ease 2.6s forwards;
  }
  .mr-caption span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #e8104c;
  }

  @keyframes mr-in {
    to {
      opacity: 1;
    }
  }
  @keyframes mr-drop {
    from {
      opacity: 0;
      margin-top: -16px;
    }
    to {
      opacity: 1;
    }
  }
  @keyframes mr-pulse {
    0% {
      transform: scale(1);
      opacity: 0.8;
    }
    100% {
      transform: scale(2.3);
      opacity: 0;
    }
  }
</style>

<script>
  // Phones: draw each route from the Kothrud dot to its pin (measured, so it fits any phone and
  // text size), then play one route after another. Pauses while off-screen or the tab is hidden.
  const box = document.querySelector<HTMLElement>('[data-mini-map]');
  const phone = window.matchMedia('(max-width: 767px)');
  const svg = box?.querySelector<SVGSVGElement>('.mr__svg');
  const hub = box?.querySelector<HTMLElement>('[data-mr-hub] .mr-pin__dot');
  if (box && svg && hub) {
    const routes = new Map([...box.querySelectorAll<SVGGElement>('[data-mr]')].map((g) => [g.dataset.mr!, g]));
    const pins = new Map([...box.querySelectorAll<HTMLElement>('[data-mr-node]')].map((a) => [a.dataset.mrNode!, a]));

    // Centre of a pin's dot in svg pixels (ignores the drop-in offset while pins animate)
    const centre = (dot: Element, origin: DOMRect) => {
      const r = dot.getBoundingClientRect();
      const pin = dot.closest<HTMLElement>('.mr-pin');
      const shift = pin ? parseFloat(getComputedStyle(pin).marginTop) || 0 : 0;
      return { x: r.left + r.width / 2 - origin.left, y: r.top + r.height / 2 - origin.top - Math.min(shift, 0) };
    };
    const layout = () => {
      if (!phone.matches) return;
      const o = svg.getBoundingClientRect();
      if (!o.width) return;
      svg.setAttribute('viewBox', `0 0 ${o.width.toFixed(1)} ${o.height.toFixed(1)}`);
      const h = centre(hub, o);
      for (const [slug, g] of routes) {
        const dot = pins.get(slug)?.querySelector('.mr-pin__dot');
        if (!dot) continue;
        const p = centre(dot, o);
        // leaves Kothrud sideways (like a road), then runs up the edge of the screen to the area
        const c = { x: p.x + (p.x < h.x ? -1 : 1) * Math.min(18, Math.abs(p.x - h.x) * 0.1), y: h.y };
        const d = `M${h.x.toFixed(1)} ${h.y.toFixed(1)}Q${c.x.toFixed(1)} ${c.y.toFixed(1)} ${p.x.toFixed(1)} ${p.y.toFixed(1)}`;
        for (const path of g.querySelectorAll('path')) path.setAttribute('d', d);
      }
      const { width: w, height: ht } = o;
      svg.querySelector('[data-mr-base="river"]')?.setAttribute('d', `M-10 ${h.y - 50}C${w * 0.25} ${h.y - 80} ${w * 0.4} ${h.y - 20} ${w * 0.6} ${h.y - 45}S${w * 0.85} ${h.y - 110} ${w + 10} ${h.y - 95}`);
      svg.querySelector('[data-mr-base="hwy"]')?.setAttribute('d', `M${w * 0.24} -10C${w * 0.2} ${ht * 0.3} ${w * 0.28} ${ht * 0.6} ${w * 0.21} ${ht + 10}`);
    };
    layout();
    new ResizeObserver(layout).observe(box.parentElement ?? document.body);
    document.fonts?.ready.then(layout);
    window.addEventListener('load', layout);

    const order = ['karvenagar', 'erandwane', 'prabhat-road', 'baner', 'bavdhan', 'warje'].filter((s) => routes.has(s));
    let current = '';
    let step = -1;
    let visible = true;

    const play = (slug: string) => {
      if (current) {
        routes.get(current)?.classList.remove('is-hot');
        pins.get(current)?.classList.remove('is-hot');
      }
      const g = routes.get(slug);
      if (!g) return;
      current = slug;
      g.classList.remove('is-hot');
      void g.getBoundingClientRect(); // restart the trail animation
      g.classList.add('is-hot');
      pins.get(slug)?.classList.add('is-hot');
      g.querySelector<SVGAnimationElement>('animateMotion')?.beginElement();
    };
    const tick = () => {
      if (visible && !document.hidden && phone.matches) {
        step = (step + 1) % order.length;
        play(order[step]);
      }
      window.setTimeout(tick, 2800);
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([e]) => (visible = e.isIntersecting), { threshold: 0.3 }).observe(box.parentElement ?? box);
    }
    window.setTimeout(tick, 3600); // after the routes have drawn in

    // The floating WhatsApp button steps aside while it would cover a pin (short phones, or scrolling past)
    const fab = document.querySelector<HTMLElement>('.wa-float');
    const marks = [...box.querySelectorAll<HTMLElement>('.mr-pin, .mr-caption')];
    let queued = false;
    const checkFab = () => {
      queued = false;
      if (!fab) return;
      // where the button sits when shown (the hidden state is nudged 12px down)
      const f = fab.getBoundingClientRect();
      const shift = document.documentElement.classList.contains('wa-over-map') ? 12 : 0;
      const over =
        phone.matches &&
        marks.some((m) => {
          const r = m.getBoundingClientRect();
          return r.left < f.right + 8 && r.right > f.left - 8 && r.top < f.bottom - shift + 8 && r.bottom > f.top - shift - 8;
        });
      document.documentElement.classList.toggle('wa-over-map', over);
    };
    const queue = () => {
      if (!queued) (queued = true), requestAnimationFrame(checkFab);
    };
    window.addEventListener('scroll', queue, { passive: true });
    window.addEventListener('resize', queue);
    checkFab();
  }
</script>
