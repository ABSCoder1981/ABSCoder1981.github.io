---
// Section 4 — "From plot to keys" (option B).
// Left: a sticky line sketch of one home that builds as you scroll through the steps:
//   1 surveyed plot → 2 foundation → 3 structure → 4 finished home + crimson key.
// Right: the four steps of how we work; each one names the problem it removes
// (this absorbs the old "Property in Pune is hard" section).
// Reduced motion: the finished home is shown and all steps are equally visible.
import home from '../../data/home.json';
import { waHref } from '../../lib/site';

const byName = Object.fromEntries(home.problems.map((p) => [p.problem, p]));
// Which problem each step solves
const solves = ['Wasted site visits', 'Unclear pricing', 'Document risk', 'Paperwork delays'];
const stages = ['Survey the plot', 'Lay the foundation', 'Raise the structure', 'Hand over the keys'];
const steps = home.process.map((s, i) => ({ ...s, n: i + 1, stage: stages[i], problem: byName[solves[i]] }));
const wa = waHref('starting with a requirement call', 'Landing page · how we work');
---

<section class="ptk" aria-labelledby="ptk-h" data-ptk data-screen data-stage="1">
  <div class="container">

    <div class="ptk__grid">
      <header class="ptk__head">
        <h2 id="ptk-h" class="ptk__title">How Ashiyana <em>Works</em></h2>
        <p class="ptk__lead">Four steps from your first call to the keys in your hand, with one team throughout. Each step removes a problem buyers and sellers tell us about.</p>
      </header>
      <!-- The home, building up as you scroll -->
      <div class="ptk__art" aria-hidden="true">
        <svg viewBox="0 0 440 400" focusable="false">
          <!-- 1. surveyed plot -->
          <g class="st st1">
            <path class="ln dash" d="M60 340L320 340L390 305L130 305Z" pathLength="1" />
            <path class="ln" d="M60 340v-14M320 340v-14M390 305v-14M130 305v-14" pathLength="1" />
            <path class="ln thin" d="M60 365H320M60 358v14M320 358v14" pathLength="1" />
            <path class="ln thin" d="M405 305L335 340M400 298l10 14M330 333l10 14" pathLength="1" />
            <path class="ln ground" d="M10 345H430" pathLength="1" />
          </g>
          <!-- 2. foundation -->
          <g class="st st2">
            <path class="ln" d="M100 320H290V332H100Z" pathLength="1" />
            <path class="ln" d="M100 320L160 290H350L290 320M290 332L350 302V290" pathLength="1" />
            <path class="ln thin" d="M130 320v12M160 320v12M195 320v12M230 320v12M260 320v12" pathLength="1" />
          </g>
          <!-- 3. structure -->
          <g class="st st3">
            <path class="ln" d="M100 320V210M195 320V210M290 320V210M350 290V180M160 290V180" pathLength="1" />
            <path class="ln" d="M100 210H290L350 180H160Z" pathLength="1" />
            <path class="ln thin" d="M100 265H290L350 235M160 235H350" pathLength="1" />
            <path class="ln" d="M100 210L195 150L290 210M195 150L255 120L350 180M160 180L255 120" pathLength="1" />
          </g>
          <!-- 4. finished home -->
          <g class="st st4">
            <path class="roof" d="M100 210L195 150L255 120L160 180Z M195 150L290 210L350 180L255 120Z" />
            <path class="wall" d="M100 210H290V320H100Z" />
            <path class="wall wall--side" d="M290 210L350 180V290L290 320Z" />
            <path class="ln" d="M100 210H290V320H100ZM290 210L350 180V290L290 320" pathLength="1" />
            <path class="ln" d="M100 210L195 150L290 210M195 150L255 120L350 180" pathLength="1" />
            <path class="ln thin" d="M120 225h45v28h-45zM225 225h45v28h-45zM120 275h45v28h-45zM225 275h45v28h-45zM142 225v28M247 225v28M142 275v28M247 275v28" pathLength="1" />
            <path class="ln" d="M178 270h34v50h-34z" pathLength="1" />
            <path class="ln thin" d="M305 228l30-15v24l-30 15zM305 275l30-15v24l-30 15z" pathLength="1" />
            <path class="ln thin" d="M40 345c0-26 16-44 26-44s26 18 26 44M66 345v-30M370 345c0-20 12-34 20-34s20 14 20 34M390 345v-22" pathLength="1" />
            <!-- the key -->
            <g class="key">
              <circle cx="236" cy="386" r="10" />
              <path d="M246 386H286M272 386v10M282 386v8" />
            </g>
          </g>
        </svg>
        <p class="ptk__stage">
          <span class="ptk__stage-k">Stage <span data-stage-num>1</span> of 4</span>
          <span data-stage-name>{stages[0]}</span>
        </p>
        <ol class="ptk__dots" role="list">
          {steps.map((s) => <li data-dot={s.n} />)}
        </ol>
      </div>

      <!-- The steps -->
      <ol role="list" class="ptk__steps">
        {
          steps.map((s) => (
            <li class="step" data-step={s.n} data-stage-name={s.stage}>
              <span class="step__n">{String(s.n).padStart(2, '0')}</span>
              <div class="step__body">
                <p class="step__stage">{s.stage}</p>
                <h3 class="step__title">
                  <button type="button" class="step__btn" aria-expanded={s.n === 1 ? 'true' : 'false'} aria-controls={`step-${s.n}-more`}>
                    {s.title}
                  </button>
                </h3>
                <div class="step__more" id={`step-${s.n}-more`}>
                <p class="step__text">{s.text}</p>
                {s.problem && (
                  <div class="step__solves">
                    <p class="step__problem">
                      <span class="step__x" aria-hidden="true">✕</span>
                      <span>
                        <strong>Problem it solves: {s.problem.problem}.</strong> {s.problem.text}
                      </span>
                    </p>
                    <p class="step__how">
                      <span class="step__tick" aria-hidden="true" />
                      <span>{s.problem.how}</span>
                    </p>
                  </div>
                )}
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="ptk__cta">
      <p><strong>Ready for step 1?</strong> A 10-minute requirement call is all it takes to start.</p>
      <div class="ptk__btns">
        <a class="ptk__btn" href={wa} target="_blank" rel="noopener" data-cta="how-we-work">Start with step 1 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<style>
  .ptk {
    position: relative;
    padding-block: clamp(44px, 5vw, 72px);
    background-color: #fbfaf7;
    background-image:
      linear-gradient(rgba(61, 74, 92, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 74, 92, 0.05) 1px, transparent 1px),
      linear-gradient(rgba(61, 74, 92, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 74, 92, 0.03) 1px, transparent 1px);
    background-size: 120px 120px, 120px 120px, 24px 24px, 24px 24px;
    border-top: 1px solid rgba(13, 37, 61, 0.06);
    color: #0d253d;
    font-family: var(--font-sans);
  }

  /* ---------- Heading ---------- */
  .ptk__head {
    max-width: 780px;
  }
  .ptk__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .ptk__num {
    font-weight: 600;
    color: #0d253d;
  }
  .ptk__rule {
    width: 40px;
    height: 1px;
    background: currentColor;
  }
  .ptk__title {
    margin: 0;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .ptk__title em {
    font-style: normal;
    font-weight: 600;
    color: #c8123f;
  }
  .ptk__lead {
    margin: 16px 0 0;
    max-width: 62ch;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #344559;
  }

  .ptk__grid {
    display: grid;
    grid-template-areas: 'head list' 'art list';
    grid-template-rows: auto 1fr;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: clamp(32px, 5vw, 80px);
    align-items: start;
  }
  .ptk__head {
    grid-area: head;
  }
  .ptk__art {
    grid-area: art;
    align-self: start;
  }
  .ptk__grid > ol {
    grid-area: list;
  }

  /* ---------- The building sketch ---------- */
  .ptk__art {
    position: relative;
    padding: 24px 24px 20px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.82);
    border: 1px solid rgba(13, 37, 61, 0.08);
    box-shadow: 0 18px 44px rgba(13, 37, 61, 0.07);
  }
  .ptk__art svg {
    display: block;
    width: 100%;
    height: auto;
    /* the whole card (drawing + caption) must fit under the navbar on short laptop screens */
    max-height: calc(100svh - 280px);
    max-height: calc(100svh - 260px);
    margin-inline: auto;
    overflow: visible;
  }
  .ln {
    fill: none;
    stroke: #3d4a5c;
    stroke-width: 1.3;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .thin {
    stroke-width: 0.9;
    opacity: 0.7;
  }
  .dash {
    stroke: #c8123f;
    stroke-dasharray: 6 6;
  }
  .ground {
    opacity: 0.35;
  }
  .roof {
    fill: #e8104c;
    opacity: 0;
  }
  .wall {
    fill: #fff;
    opacity: 0;
  }
  .key circle,
  .key path {
    fill: none;
    stroke: #e8104c;
    stroke-width: 3;
    stroke-linecap: round;
  }

  /* Each stage draws in when the scroll reaches its step; earlier stages stay */
  .st .ln {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition: stroke-dashoffset 1.1s ease;
  }
  .st .dash {
    stroke-dasharray: 1; /* draw as a line first, switch to dashes once drawn */
  }
  .st .key {
    opacity: 0;
    transform: translateY(10px) rotate(-12deg);
    transform-box: fill-box;
    transform-origin: center;
    transition: opacity 0.6s ease 0.9s, transform 0.8s cubic-bezier(0.2, 1.4, 0.4, 1) 0.9s;
  }
  .ptk[data-stage='1'] .st1 .ln,
  .ptk[data-stage='2'] :is(.st1, .st2) .ln,
  .ptk[data-stage='3'] :is(.st1, .st2, .st3) .ln,
  .ptk[data-stage='4'] .st .ln {
    stroke-dashoffset: 0;
  }
  .ptk[data-stage='2'] .st1 .dash,
  .ptk[data-stage='3'] .st1 .dash,
  .ptk[data-stage='4'] .st1 .dash {
    stroke-dasharray: 0.012 0.012;
  }
  .ptk[data-stage='4'] .st4 .roof {
    opacity: 0.12;
    transition: opacity 0.8s ease 0.6s;
  }
  .ptk[data-stage='4'] .st4 .wall {
    opacity: 1;
    transition: opacity 0.6s ease 0.4s;
  }
  /* once finished, the scaffolding of earlier stages fades back */
  .ptk[data-stage='4'] .st3 .ln {
    opacity: 0.25;
    transition: stroke-dashoffset 1.1s ease, opacity 0.8s ease;
  }
  .ptk[data-stage='4'] .st4 .key {
    opacity: 1;
    transform: none;
  }

  .ptk__stage {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 12px;
    margin: 14px 0 0;
    font-size: 1.0625rem;
    font-weight: 500;
  }
  .ptk__stage-k {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .ptk__dots {
    display: flex;
    gap: 8px;
    margin: 12px 0 0;
  }
  .ptk__dots li {
    flex: 1;
    height: 4px;
    border-radius: 4px;
    background: rgba(13, 37, 61, 0.1);
    transition: background-color 0.4s ease;
  }
  .ptk__dots li.is-done {
    background: #e8104c;
  }

  /* ---------- Steps ---------- */
  .ptk__steps {
    position: relative;
    display: grid;
    gap: clamp(20px, 3vw, 28px);
    margin: 0;
  }
  /* room after the last step, so the finished house stays pinned while step 4 is read */
  @media (min-width: 900px) {
    .ptk__steps {
      padding-bottom: 0;
    }
  }
  /* the dashed route: from each step circle down to the next one, none after the last */
  .step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 25px;
    top: 52px;
    bottom: calc(-1 * clamp(20px, 3vw, 28px));
    border-left: 2px dashed rgba(200, 18, 63, 0.35);
  }
  .step {
    position: relative;
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    gap: 20px;
    align-items: start;
    cursor: pointer;
    transition: opacity 0.4s ease;
  }
  .step__n {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: #fff;
    border: 2px solid rgba(13, 37, 61, 0.18);
    font-size: 0.9375rem;
    font-weight: 600;
    color: #4e5d73;
    transition: background-color 0.4s ease, border-color 0.4s ease, color 0.4s ease, box-shadow 0.4s ease;
  }
  .step__body {
    padding: 22px 26px 24px;
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(13, 37, 61, 0.08);
    transition: background-color 0.4s ease, border-color 0.4s ease, box-shadow 0.4s ease;
  }
  .step__stage {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .step__title {
    margin: 6px 0 0;
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    font-weight: 500;
    letter-spacing: -0.005em;
  }
  .step__text {
    margin: 8px 0 0;
    font-family: var(--font-sans);
    font-size: 1rem;
    line-height: 1.6;
    color: #344559;
  }
  .step__solves {
    display: grid;
    gap: 10px;
    margin-top: 16px;
    padding-top: 14px;
    border-top: 1px dashed rgba(13, 37, 61, 0.16);
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.55;
  }
  .step__problem,
  .step__how {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 8px;
    margin: 0;
  }
  .step__problem {
    color: #4e5d73;
  }
  .step__problem strong {
    font-weight: 600;
    color: #0d253d;
  }
  .step__x {
    display: grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    background: #f1f3f6;
    font-size: 0.6875rem;
    color: #4e5d73;
  }
  .step__how {
    color: #0d253d;
    font-weight: 500;
  }
  .step__tick {
    width: 20px;
    height: 20px;
    margin-top: 1px;
    border-radius: 50%;
    background: #fdecf0;
    position: relative;
  }
  .step__tick::after {
    content: '';
    position: absolute;
    left: 6px;
    top: 5px;
    width: 8px;
    height: 4px;
    border-left: 2px solid #c8123f;
    border-bottom: 2px solid #c8123f;
    transform: rotate(-45deg);
  }

  /* Active and completed steps */
  .step.is-done .step__n {
    background: #fdecf0;
    border-color: #e8104c;
    color: #b80f3a;
  }
  .step.is-active .step__n {
    background: #c8123f;
    border-color: #c8123f;
    color: #fff;
    box-shadow: 0 0 0 6px rgba(232, 16, 76, 0.14);
  }
  .step.is-active .step__body {
    background: #fff;
    border-color: rgba(232, 16, 76, 0.35);
    box-shadow: 0 18px 40px rgba(200, 18, 63, 0.1);
  }

  /* ---------- Stepper: only the active step is open ---------- */
  .step__btn {
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    color: inherit;
    text-align: left;
    cursor: pointer;
  }
  .step__btn:focus-visible {
    outline: 2px solid #c8123f;
    outline-offset: 4px;
    border-radius: 4px;
  }
  .step:not(.is-active) .step__stage,
  .step:not(.is-active) .step__more {
    display: none;
  }
  .step:not(.is-active) .step__body {
    padding-block: 12px;
  }
  .step:not(.is-active) .step__title {
    margin: 0;
    font-size: 1.125rem;
  }
  .step:not(.is-active):hover .step__title {
    color: #c8123f;
  }
  .ptk__steps {
    gap: 12px;
  }
  .step:not(:last-child)::after {
    bottom: -12px;
  }
  .step {
    min-height: 0;
  }
  .step__solves {
    margin-top: 12px;
    padding-top: 10px;
  }
  /* autoplay progress line on the active step */
  .step.is-active .step__body {
    position: relative;
    overflow: hidden;
  }
  .ptk.is-playing .step.is-active .step__body::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 3px;
    width: 100%;
    background: #e8104c;
    transform-origin: left;
    animation: ptk-progress var(--step-ms, 7000ms) linear forwards;
  }
  @keyframes ptk-progress {
    from {
      transform: scaleX(0);
    }
  }

  /* ---------- CTA ---------- */
  .ptk__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 24px;
    margin-top: clamp(16px, 2.5vh, 28px);
    padding: 14px 22px;
    border-radius: 18px;
    background: #1d0f16;
    color: #f6e8ec;
  }
  .ptk__cta p {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
  }
  .ptk__cta strong {
    font-family: var(--font-sans);
    font-weight: 600;
    color: #fff;
  }
  .ptk__btns {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 18px;
  }
  .ptk__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    padding: 0 26px;
    border-radius: 9999px;
    background: linear-gradient(110deg, #e8104c 0%, #c8123f 50%, #9e0c33 100%);
    color: #fff;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none !important;
    box-shadow: 0 10px 24px rgba(232, 16, 76, 0.3);
    transition: transform 0.2s ease;
  }
  .ptk__btn:hover {
    transform: translateY(-1px);
  }

  /* ---------- Entrance ---------- */
  @media all {
    .ptk__head,
    .ptk__grid {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .ptk__grid {
      transition-delay: 0.2s;
    }
    .ptk.is-in .ptk__head,
    .ptk.is-in .ptk__grid {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 899px) {
    .ptk__art svg {
      max-height: none;
    }
    .ptk__grid {
      grid-template-areas: 'head' 'art' 'list';
      grid-template-rows: auto;
      grid-template-columns: minmax(0, 1fr);
    }
    /* compact sketch pinned under the navbar while the steps scroll */
    .ptk__art {
      position: relative;
      top: auto;
      display: grid;
      grid-template-columns: 140px minmax(0, 1fr);
      grid-template-rows: auto auto;
      column-gap: 14px;
      align-items: center;
      padding: 10px 14px;
      border-radius: 14px;
      box-shadow: 0 10px 24px rgba(13, 37, 61, 0.1);
      -webkit-backdrop-filter: blur(8px);
      backdrop-filter: blur(8px);
    }
    .ptk__art svg {
      grid-row: span 2;
    }
    .ptk__stage {
      margin: 0;
      font-size: 0.9375rem;
    }
    .ptk__dots {
      margin: 0;
    }
    .step {
      min-height: 0;
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 12px;
    }
    .step__n {
      width: 40px;
      height: 40px;
    }
    .step:not(:last-child)::after {
      left: 19px;
      top: 40px;
    }
    .step__body {
      padding: 18px;
    }
  }

  /* ===== One-screen compaction ===== */

  .ptk__lead { margin-top: 10px; }
  @media (max-width: 899px) {
    .ptk__lead, .ptk__cta p { display: none; }
    .ptk__title { font-size: 1.8rem; }
    .ptk__art { grid-template-columns: 110px minmax(0, 1fr); }
    .step__problem { display: none; }
    .ptk__cta { justify-content: center; }
  }
  /* Dark bar: text left, button centre, call right (as in the services box) */
  @media (min-width: 900px) {
    .ptk__btns {
      display: contents;
    }
  }
  /* Phones: taller tap target, so the one-screen scaling can shrink this section and still keep it 44px+ */
  @media (max-width: 767px) {
    .step__btn {
      display: flex;
      align-items: center;
      min-height: 52px;
    }
  }
  /* Phones: tighter steps so the section stays one screen with 44px+ step buttons */
  @media (max-width: 767px) {
    .ptk__steps {
      gap: 6px;
    }
    .step:not(:last-child)::after {
      bottom: -6px;
    }
    .step__solves {
      display: none;
    }
  }
  /* Heading centred across the section, above the drawing and the steps */
  @media (min-width: 900px) {
    .ptk__grid {
      grid-template-areas: 'head head' 'art list';
      grid-template-rows: auto 1fr;
      row-gap: clamp(12px, 2.4vh, 28px);
    }
    .ptk__head {
      justify-self: center;
      text-align: center;
    }
  }
  /* Dark bar: text at the left, button at the right */
  .ptk__cta {
    justify-content: space-between;
  }
  /* Phones and small tablets: the house drawing gets the full card width (it was a 110px thumbnail),
     with the stage name and progress bar centred under it */
  @media (max-width: 899px) {
    .ptk__art {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
      row-gap: 6px;
      padding: 12px 16px 14px;
    }
    .ptk__art svg {
      grid-row: auto;
      width: auto;
      max-width: 100%;
      height: clamp(150px, 26svh, 240px);
    }
    .ptk__stage {
      justify-content: center;
      justify-self: stretch;
    }
    .ptk__dots {
      justify-self: stretch;
    }
  }
  /* Phones: the "Start with step 1" button centred in the dark bar */
  @media (max-width: 767px) {
    .ptk__cta {
      justify-content: center;
    }
    .ptk__btns {
      width: 100%;
      justify-content: center;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ptk]');
  if (root) {
    const steps = [...root.querySelectorAll<HTMLElement>('[data-step]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const stageNum = root.querySelector('[data-stage-num]')!;
    const stageName = root.querySelector('[data-stage-name]')!;

    const setStage = (n: number) => {
      root.dataset.stage = String(n);
      stageNum.textContent = String(n);
      stageName.textContent = steps[n - 1].dataset.stageName || '';
      steps.forEach((s, i) => {
        s.classList.toggle('is-active', i === n - 1);
        s.classList.toggle('is-done', i < n - 1);
      });
      dots.forEach((d, i) => d.classList.toggle('is-done', i < n));
    };

    // Reserve the height of the tallest stage so the section never changes size
    const list = root.querySelector<HTMLElement>('.ptk__steps')!;
    const reserve = () => {
      list.style.minHeight = '';
      let max = 0;
      const keep = Number(root.dataset.stage) || 1;
      for (let n = 1; n <= steps.length; n++) {
        steps.forEach((s, i) => s.classList.toggle('is-active', i === n - 1));
        max = Math.max(max, list.offsetHeight);
      }
      setStage(keep);
      list.style.minHeight = max + 'px';
    };

    const STEP_MS = 7000;
    root.style.setProperty('--step-ms', STEP_MS + 'ms');
    let timer: number | undefined;
    let userTook = false;
    const go = (n: number) => {
      setStage(n);
      steps.forEach((s, i) => s.querySelector('.step__btn')?.setAttribute('aria-expanded', String(i === n - 1)));
    };
    const play = () => {
      if (userTook) return;
      window.clearInterval(timer);
      root.classList.add('is-playing');
      timer = window.setInterval(() => go((Number(root.dataset.stage) % steps.length) + 1), STEP_MS);
    };
    const stop = () => {
      window.clearInterval(timer);
      root.classList.remove('is-playing');
    };
    steps.forEach((s, i) =>
      s.addEventListener('click', () => {
        userTook = true;
        stop();
        go(i + 1);
      }),
    );
    // Pause while a mouse rests on the section. Touch is ignored: a tap fires mouseenter without a
    // matching mouseleave, which used to stop the house on phones for good.
    root.addEventListener('pointerenter', (e) => e.pointerType === 'mouse' && stop());
    root.addEventListener('pointerleave', (e) => e.pointerType === 'mouse' && play());
    root.addEventListener('focusin', stop);

    go(1);
    reserve();
    window.addEventListener('resize', reserve);
    document.fonts?.ready.then(reserve);

    if (!('IntersectionObserver' in window)) root.classList.add('is-in');
    else {
      new IntersectionObserver(
        (es) => {
          const e = es[0];
          if (e.isIntersecting) {
            root.classList.add('is-in');
            play();
          } else stop();
        },
        { threshold: 0.5 },
      ).observe(root);
    }
  }
</script>
