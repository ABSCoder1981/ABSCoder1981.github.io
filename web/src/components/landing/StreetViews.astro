---
// Section 5 — "Where we work" (option C).
// Street views: six tabs, one per locality. Each shows a line-sketch street elevation of the
// kind of homes typical of that area (generic building types, no real buildings) beside the
// facts we already publish: description, typical homes, price range scale, distance from office.
import { localities } from '../../lib/site';

// ---------------- Street elevation generator (viewBox 600 × 320) ----------------
const GY = 286; // ground line
type Part = { d: string; k: 'body' | 'ln' | 'thin' | 'accent' | 'leaf' };
const r1 = (n: number) => Math.round(n * 10) / 10;

function block(x: number, w: number, floors: number, fh = 22): Part[] {
  const top = GY - floors * fh;
  let floorsD = '';
  for (let f = 1; f < floors; f++) floorsD += `M${x} ${GY - f * fh}H${x + w}`;
  let mull = '';
  for (let c = x + 16; c < x + w - 8; c += 18) mull += `M${c} ${top + 6}V${GY - 4}`;
  const tank = `M${x + w * 0.6} ${top}v-10h${w * 0.22}v10`;
  return [
    { d: `M${x} ${GY}V${top}H${x + w}V${GY}Z`, k: 'body' },
    { d: `M${x} ${GY}V${top}H${x + w}V${GY}` + tank, k: 'ln' },
    { d: floorsD + mull, k: 'thin' },
  ];
}
function tower(x: number, w: number, floors: number, fh = 15): Part[] {
  const top = GY - floors * fh;
  let floorsD = '';
  for (let f = 1; f < floors; f++) floorsD += `M${x} ${GY - f * fh}H${x + w}`;
  let mull = '';
  for (let c = x + 12; c < x + w - 6; c += 12) mull += `M${c} ${top + 4}V${GY - 4}`;
  const crown = `M${x + 6} ${top}V${top - 14}H${x + w - 6}V${top}M${x + w / 2} ${top - 14}V${top - 30}`;
  return [
    { d: `M${x} ${GY}V${top}H${x + w}V${GY}Z`, k: 'body' },
    { d: `M${x} ${GY}V${top}H${x + w}V${GY}` + crown, k: 'ln' },
    { d: floorsD + mull, k: 'thin' },
  ];
}
function bungalow(x: number, w: number): Part[] {
  const g = GY - 34;
  const u = g - 32;
  const peak = u - 30;
  const outline = `M${x} ${GY}V${u}H${x + w}V${GY}Z`;
  const roof = `M${x - 8} ${u}L${x + w / 2} ${peak}L${x + w + 8} ${u}Z`;
  const details =
    `M${x} ${g}H${x + w}` +
    `M${x + w / 2 - 9} ${GY}v-24h18v24` +
    `M${x + 12} ${g - 22}h20v14h-20zM${x + w - 32} ${g - 22}h20v14h-20z` +
    `M${x + 12} ${GY - 24}h18v14h-18zM${x + w - 30} ${GY - 24}h18v14h-18z`;
  return [
    { d: outline + roof, k: 'body' },
    { d: `M${x} ${GY}V${u}H${x + w}V${GY}` + roof, k: 'ln' },
    { d: details, k: 'thin' },
  ];
}
function tree(x: number, s = 1): Part[] {
  const rr = 16 * s;
  const cy = GY - 30 * s - rr;
  return [
    { d: `M${x} ${GY}V${cy + rr * 0.6}`, k: 'ln' },
    { d: `M${x - rr} ${cy}a${rr} ${rr} 0 1 0 ${2 * rr} 0a${rr} ${rr} 0 1 0 ${-2 * rr} 0`, k: 'leaf' },
  ];
}
function metro(y: number): Part[] {
  let p = '';
  for (let x = 40; x < 600; x += 110) p += `M${x} ${y + 10}V${GY}M${x + 10} ${y + 10}V${GY}`;
  return [
    { d: `M0 ${y}H600M0 ${y + 10}H600`, k: 'accent' },
    { d: p, k: 'thin' },
  ];
}
function hill(): Part[] {
  return [{ d: `M0 ${GY - 70}C120 ${GY - 150} 230 ${GY - 160} 330 ${GY - 110}S520 ${GY - 60} 600 ${GY - 120}`, k: 'thin' }];
}
function road(): Part[] {
  return [
    { d: `M0 ${GY + 18}H600`, k: 'ln' },
    { d: `M0 ${GY + 9}H600`, k: 'accent' },
  ];
}
function wall(gateX: number): Part[] {
  return [{ d: `M0 ${GY - 16}H${gateX}M${gateX + 50} ${GY - 16}H600M${gateX} ${GY}V${GY - 30}M${gateX + 50} ${GY}V${GY - 30}`, k: 'ln' }];
}

const scenes: Record<string, { parts: Part[][]; caption: string }> = {
  kothrud: {
    caption: 'Settled societies, redevelopment and the metro line',
    parts: [metro(118), block(20, 120, 6), tree(160), block(180, 110, 7), block(310, 130, 5), tree(458, 1.1), block(480, 100, 6)],
  },
  karvenagar: {
    caption: 'Quiet, green lanes with societies and independent homes',
    parts: [tree(20, 1.2), block(50, 110, 4), bungalow(190, 100), tree(312, 1.3), block(340, 120, 5), tree(475), bungalow(495, 90)],
  },
  warje: {
    caption: 'Newer high-rise projects along the highway',
    parts: [road(), tower(40, 70, 14), tower(130, 70, 16), block(222, 110, 5), tower(352, 76, 15), tower(450, 64, 12), tree(538)],
  },
  'prabhat-road': {
    caption: 'Tree-lined lanes, bungalows and premium low-rise',
    parts: [tree(18, 1.3), bungalow(40, 110), tree(175, 1.4), bungalow(205, 100), block(330, 120, 4), tree(468, 1.3), bungalow(490, 96)],
  },
  bavdhan: {
    caption: 'Gated towers against the Bavdhan hills',
    parts: [hill(), tower(70, 80, 13), tower(180, 80, 15), tower(300, 80, 14), tree(410, 1.2), block(450, 110, 5), wall(240)],
  },
  erandwane: {
    caption: 'Older societies and redeveloped buildings, central and quiet',
    parts: [block(20, 110, 4), block(150, 120, 8), tree(292, 1.2), block(320, 100, 4), bungalow(445, 110)],
  },
};

// ---------------- Price range: words → a 4-step scale ----------------
const level = (band: string) => {
  const b = band.toLowerCase();
  const hits = [b.includes('entry') && 1, b.includes('mid') && 2, b.includes('premium') && 3, b.includes('luxury') && 4].filter(Boolean) as number[];
  return hits;
};
const scaleNames = ['Entry', 'Mid', 'Premium', 'Luxury'];

const areas = localities.map((l) => {
  const lv = l.propertyTypes.flatMap((t) => level(t.band));
  const lo = Math.min(...lv);
  const hi = Math.max(...lv);
  return {
    slug: l.slug,
    name: l.name,
    hq: l.slug === 'kothrud',
    about: l.about[0],
    homes: l.propertyTypes.slice(0, 3).map((t) => t.type),
    lo,
    hi,
    range: lo === hi ? scaleNames[lo - 1] : `${scaleNames[lo - 1]} to ${scaleNames[hi - 1]}`,
    distance: l.slug === 'kothrud' ? 'Our head office is here' : l.distance.replace(' from our Kothrud office', ''),
    scene: scenes[l.slug],
  };
});

---

<section class="lx" aria-labelledby="lx-h" data-lx data-screen>
  <div class="container">
    <header class="lx__head">
      <h2 id="lx-h" class="lx__title"><span class="lx__t-wide">Six neighbourhoods. <em>We know every street.</em></span><span class="lx__t-phone">Know the street <em>before you buy.</em></span></h2>
      <p class="lx__lead">Pick an area to see what it's like, the homes you'll find there and how far it is from our Kothrud office.</p>
    </header>

    <!-- Part 1: street views -->
    <div class="lx__tabs" role="tablist" aria-label="Neighbourhoods">
      <span class="lx__pill" aria-hidden="true"></span>
      {
        areas.map((a, i) => (
          <button
            type="button"
            role="tab"
            class="lx__tab"
            id={`lx-tab-${a.slug}`}
            aria-controls={`lx-panel-${a.slug}`}
            aria-selected={i === 0 ? 'true' : 'false'}
            tabindex={i === 0 ? 0 : -1}
          >
            {a.name}
            {a.hq && <span class="lx__hq">HQ</span>}
          </button>
        ))
      }
    </div>

    {
      areas.map((a, i) => (
        <div
          class:list={['lx__panel', { 'is-active': i === 0 }]}
          role="tabpanel"
          id={`lx-panel-${a.slug}`}
          aria-labelledby={`lx-tab-${a.slug}`}
          hidden={i !== 0}
        >
          <figure class="lx__scene">
            <svg viewBox="0 0 600 320" aria-hidden="true" focusable="false">
              <path class="sv-ground" d={`M0 ${GY}H600`} />
              {a.scene.parts.map((group, gi) => (
                <g style={`--g:${gi}`}>
                  {group.map((p) =>
                    p.k === 'body' ? <path class="sv-body" d={p.d} /> : <path class={`sv sv-${p.k}`} d={p.d} pathLength="1" />,
                  )}
                </g>
              ))}
            </svg>
            <figcaption>{a.scene.caption}</figcaption>
          </figure>

          <div class="lx__facts">
            <p class="lx__area">
              {a.name}
              {a.hq && <span class="lx__badge">Head office</span>}
            </p>
            <p class="lx__about">{a.about}</p>
            <dl class="lx__dl">
              <div>
                <dt>Typical homes</dt>
                <dd>
                  <ul role="list" class="lx__homes">
                    {a.homes.map((h) => (
                      <li>{h}</li>
                    ))}
                  </ul>
                </dd>
              </div>
              <div>
                <dt>Price range</dt>
                <dd>
                  <span class="lx__scale" aria-hidden="true">
                    {[1, 2, 3, 4].map((n) => (
                      <span class:list={{ on: n >= a.lo && n <= a.hi }} />
                    ))}
                  </span>
                  <span class="lx__range">{a.range}</span>
                </dd>
              </div>
              <div>
                <dt>From our office</dt>
                <dd>{a.distance}</dd>
              </div>
            </dl>
          </div>
        </div>
      ))
    }

  </div>
</section>

<style>
  .lx {
    position: relative;
    padding-block: clamp(44px, 5vw, 72px);
    background-color: #fff;
    background-image:
      linear-gradient(rgba(61, 74, 92, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 74, 92, 0.045) 1px, transparent 1px);
    background-size: 120px 120px;
    border-top: 1px solid rgba(13, 37, 61, 0.06);
    color: #0d253d;
    font-family: var(--font-sans);
  }

  /* ---------- Heading ---------- */
  .lx__head {
    max-width: 780px;
  }
  .lx__eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: #b80f3a;
  }
  .lx__num {
    font-weight: 600;
    color: #0d253d;
  }
  .lx__rule {
    width: 40px;
    height: 1px;
    background: currentColor;
  }
  .lx__title {
    margin: 0;
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.25rem);
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }
  .lx__title em {
    font-style: normal;
    font-weight: 600;
    color: #c8123f;
  }
  .lx__lead {
    margin: 16px 0 0;
    max-width: 62ch;
    font-family: var(--font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: #344559;
  }

  /* ---------- Tabs ---------- */
  .lx__tabs {
    display: flex;
    gap: 8px;
    margin-top: clamp(32px, 4vw, 48px);
    padding: 6px;
    border-radius: 9999px;
    background: #f6f2f3;
    border: 1px solid rgba(13, 37, 61, 0.06);
    width: fit-content;
    max-width: 100%;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .lx__tabs::-webkit-scrollbar {
    display: none;
  }
  .lx__tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 20px;
    border: 0;
    border-radius: 9999px;
    background: transparent;
    font: inherit;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: #344559;
    cursor: pointer;
    transition: background-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
  }
  .lx__tab:hover {
    color: #c8123f;
  }
  .lx__tab[aria-selected='true'] {
    color: #c8123f;
  }
  /* The white highlight is one pill that slides to the selected tab */
  .lx__tabs {
    position: relative;
  }
  .lx__tab {
    position: relative;
    z-index: 1;
    transition: color 0.35s ease;
  }
  .lx__pill {
    position: absolute;
    top: 6px;
    left: 0;
    height: 44px;
    width: 0;
    border-radius: 9999px;
    background: #fff;
    box-shadow: 0 6px 16px rgba(13, 37, 61, 0.1);
    pointer-events: none;
    transition:
      transform 0.55s cubic-bezier(0.65, 0, 0.35, 1),
      width 0.55s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .lx__pill.no-anim {
    transition: none;
  }
  /* The new area's panel slides in from the side you moved towards */
  .lx__panel.slide-next {
    animation: lx-slide-next 0.6s cubic-bezier(0.22, 0.7, 0.2, 1) both;
  }
  .lx__panel.slide-prev {
    animation: lx-slide-prev 0.6s cubic-bezier(0.22, 0.7, 0.2, 1) both;
  }
  @keyframes lx-slide-next {
    from {
      opacity: 0;
      transform: translateX(48px);
    }
  }
  @keyframes lx-slide-prev {
    from {
      opacity: 0;
      transform: translateX(-48px);
    }
  }
  .lx__tab:focus-visible {
    outline: none;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #c8123f;
  }
  .lx__hq {
    padding: 1px 6px;
    border-radius: 6px;
    background: #fdecf0;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: #b80f3a;
  }

  /* ---------- Panel ---------- */
  .lx__panel {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: center;
    margin-top: 24px;
    padding: clamp(20px, 3vw, 32px);
    border-radius: 22px;
    background: rgba(255, 255, 255, 0.86);
    border: 1px solid rgba(13, 37, 61, 0.08);
    box-shadow: 0 20px 48px rgba(13, 37, 61, 0.07);
  }
  .lx__panel[hidden] {
    display: none;
  }
  .lx__scene {
    margin: 0;
    padding: 18px 18px 12px;
    border-radius: 16px;
    background:
      linear-gradient(rgba(61, 74, 92, 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(61, 74, 92, 0.05) 1px, transparent 1px),
      #fbfaf7;
    background-size: 24px 24px;
  }
  .lx__scene svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  .lx__scene figcaption {
    margin-top: 6px;
    font-size: 0.8125rem;
    letter-spacing: 0.04em;
    color: #4e5d73;
  }
  .sv-ground {
    fill: none;
    stroke: #3d4a5c;
    stroke-width: 1.4;
  }
  .sv-body {
    fill: #fff;
  }
  .sv {
    fill: none;
    stroke: #3d4a5c;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sv-ln {
    stroke-width: 1.3;
  }
  .sv-thin {
    stroke-width: 0.8;
    opacity: 0.65;
  }
  .sv-accent {
    stroke: #e8104c;
    stroke-width: 1.4;
    stroke-dasharray: 8 6;
  }
  .sv-leaf {
    stroke: #c8123f;
    stroke-width: 1;
    opacity: 0.55;
  }

  /* draw-in when a panel becomes active */
  @media all {
    .lx__panel .sv {
      stroke-dasharray: 1;
      stroke-dashoffset: 1;
      transition: stroke-dashoffset 1.3s ease calc(var(--g, 0) * 0.12s);
    }
    .lx__panel .sv-accent {
      transition: stroke-dashoffset 1.3s ease calc(var(--g, 0) * 0.12s), stroke-dasharray 0s linear 1.6s;
    }
    .lx__panel .sv-body {
      opacity: 0;
      transition: opacity 0.6s ease calc(0.2s + var(--g, 0) * 0.12s);
    }
    .lx.is-in .lx__panel.is-drawn .sv {
      stroke-dashoffset: 0;
    }
    .lx.is-in .lx__panel.is-drawn .sv-accent {
      stroke-dasharray: 0.02 0.015;
    }
    .lx.is-in .lx__panel.is-drawn .sv-body {
      opacity: 1;
    }
    .lx__panel .lx__facts > * {
      opacity: 0;
      transform: translateY(10px);
      transition: opacity 0.5s ease, transform 0.5s ease;
    }
    .lx.is-in .lx__panel.is-drawn .lx__facts > * {
      opacity: 1;
      transform: none;
    }
    .lx__panel.is-drawn .lx__facts > :nth-child(2) { transition-delay: 0.08s; }
    .lx__panel.is-drawn .lx__facts > :nth-child(3) { transition-delay: 0.16s; }
    .lx__panel.is-drawn .lx__facts > :nth-child(4) { transition-delay: 0.24s; }
  }

  .lx__area {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .lx__badge {
    padding: 3px 10px;
    border-radius: 9999px;
    background: #c8123f;
    font-size: 0.6875rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #fff;
  }
  .lx__about {
    margin: 10px 0 0;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    line-height: 1.65;
    color: #344559;
  }
  .lx__dl {
    display: grid;
    gap: 14px;
    margin: 18px 0 0;
    padding-top: 16px;
    border-top: 1px dashed rgba(13, 37, 61, 0.16);
  }
  .lx__dl > div {
    display: grid;
    grid-template-columns: 130px minmax(0, 1fr);
    gap: 12px;
    align-items: start;
  }
  .lx__dl dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #b80f3a;
    padding-top: 2px;
  }
  .lx__dl dd {
    margin: 0;
    font-family: var(--font-sans);
    font-size: 0.9375rem;
    color: #0d253d;
  }
  .lx__homes {
    display: grid;
    gap: 4px;
    margin: 0;
  }
  .lx__homes li::before {
    content: '·';
    margin-right: 6px;
    color: #c8123f;
    font-weight: 700;
  }
  .lx__scale {
    display: inline-flex;
    gap: 4px;
    margin-right: 10px;
    vertical-align: middle;
  }
  .lx__scale span {
    width: 26px;
    height: 8px;
    border-radius: 4px;
    background: rgba(13, 37, 61, 0.1);
  }
  .lx__scale span.on {
    background: #e8104c;
  }
  .lx__range {
    vertical-align: middle;
  }

  /* ---------- Sanaswadi site plan ---------- */
  .bp {
    fill: none;
    stroke: #fff;
    stroke-width: 0.6;
    vector-effect: non-scaling-stroke;
    stroke-width: 2;
  }
  .bp--dim {
    stroke: #fff;
  }


  /* entrance */
  @media all {
    .lx__head,
    .lx__tabs {
      opacity: 0;
      transform: translateY(22px);
      transition: opacity 0.8s ease, transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
    }
    .lx.is-in .lx__head,
    .lx.is-in .lx__tabs {
      opacity: 1;
      transform: none;
    }
  }

  /* ---------- Responsive ---------- */
  @media (max-width: 899px) {
    .lx__panel,
    .lx__tabs {
      width: auto;
    }
  }
  @media (max-width: 560px) {
    .lx__dl > div {
      grid-template-columns: minmax(0, 1fr);
      gap: 4px;
    }
  }

  /* ===== One-screen compaction ===== */

  .lx__panel { margin-top: 16px; padding: clamp(14px, 2.4vh, 28px); }
  .lx__tabs { margin-top: clamp(14px, 2.6vh, 32px); }
  .lx__scene svg { max-height: calc(100svh - 420px); }
  @media (max-width: 899px) {
    .lx__lead, .lx__scene figcaption { display: none; }
    .lx__title { font-size: 1.8rem; }
    .lx__scene { padding: 8px; }
    .lx__scene svg { max-height: 20svh; }
    .lx__about { display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
    .lx__homes li:nth-child(n + 3) { display: none; }
    .lx__dl { gap: 8px; margin-top: 10px; padding-top: 10px; }
  }
  /* Heading and tab bar centred */
  .lx__head {
    margin-inline: auto;
    text-align: center;
  }
  .lx__tabs {
    width: fit-content;
    max-width: 100%;
    margin-inline: auto;
  }
  /* Phones: taller tap target, so the one-screen scaling can shrink this section and still keep it 44px+ */
  @media (max-width: 767px) {
    .lx__tab {
      min-height: 50px;
    }
    .lx__pill {
      height: 50px;
    }
  }
  /* Phones: own heading line; the drawing sits on top of the card with the facts below it */
  .lx__t-phone {
    display: none;
  }
  @media (max-width: 767px) {
    .lx__t-wide {
      display: none;
    }
    .lx__t-phone {
      display: inline;
    }
    .lx__panel {
      grid-template-columns: minmax(0, 1fr);
      gap: 14px;
      align-items: start;
    }
    .lx__scene {
      padding: 6px 4px 0;
    }
    .lx__scene svg {
      display: block;
      width: 100%;
      height: auto;
      max-height: 26svh;
      margin-inline: auto;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-lx]');
  if (root) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const panels = tabs.map((t) => document.getElementById(t.getAttribute('aria-controls')!)!);
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // move the highlight pill under tab i (instantly on first paint and on resize)
    const pill = root.querySelector<HTMLElement>('.lx__pill');
    let current = Math.max(0, tabs.findIndex((t) => t.getAttribute('aria-selected') === 'true'));
    const placePill = (i: number, animate = true) => {
      if (!pill) return;
      pill.classList.toggle('no-anim', !animate);
      pill.style.width = `${tabs[i].offsetWidth}px`;
      pill.style.transform = `translateX(${tabs[i].offsetLeft}px)`;
    };
    placePill(current, false);
    document.fonts?.ready.then(() => placePill(current, false));
    window.addEventListener('resize', () => placePill(current, false));

    const select = (i: number, focus = false) => {
      if (i !== current) {
        const dir = i > current ? 'slide-next' : 'slide-prev';
        panels[i].classList.remove('slide-next', 'slide-prev');
        void panels[i].offsetWidth; // restart the slide if the same panel is shown again
        panels[i].classList.add(dir);
      }
      current = i;
      placePill(i);
      tabs.forEach((t, k) => {
        const on = k === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        panels[k].hidden = !on;
        panels[k].classList.toggle('is-active', on);
        if (!on) panels[k].classList.remove('is-drawn');
      });
      // next frame: start the draw-in (so the transition runs after the panel becomes visible)
      requestAnimationFrame(() => requestAnimationFrame(() => panels[i].classList.add('is-drawn')));
      if (focus) tabs[i].focus();
      tabs[i].scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduced ? 'auto' : 'smooth' });
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(i));
      t.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        const cur = tabs.indexOf(document.activeElement as HTMLButtonElement);
        let next = -1;
        if (e.key === 'ArrowRight') next = cur === last ? 0 : cur + 1;
        else if (e.key === 'ArrowLeft') next = cur === 0 ? last : cur - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next >= 0) {
          e.preventDefault();
          select(next, true);
        }
      });
    });

    // Entrance + first draw-in when the section scrolls into view
    if (!('IntersectionObserver' in window)) {
      root.classList.add('is-in');
      panels[0].classList.add('is-drawn');
    } else {
      const io = new IntersectionObserver(
        (es) => {
          for (const e of es) {
            if (!e.isIntersecting) continue;
            if (e.target === root) {
              root.classList.add('is-in');
              panels[0].classList.add('is-drawn');
            } else e.target.classList.add('is-in');
            io.unobserve(e.target);
          }
        },
        { threshold: 0.12 },
      );
      io.observe(root);
    }
  }
</script>
