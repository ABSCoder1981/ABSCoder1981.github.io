---
// Hero background: inline SVG of 3 towers under construction (2-point perspective).
// Generated by scripts/gen-tower-sketch.mjs; edit the generator, not the SVG.
//
// Motion: the skyline is DRAWN, line by line, like a pencil sketch being made.
//  - Every line is its own stroke (class "s") with its own delay (--d) and duration (--t).
//    Lines run: stroke-dashoffset goes from "not drawn" to "drawn", and each new line starts
//    in the logo crimson (the pen tip) and settles to graphite.
//  - Order: ground lines, then the vertical edges climb (class "r": linear), floor lines run
//    outward as the edge passes them, window mullions follow, roof lines close the top.
//  - The crane builds its mast then its jib; tower 3 keeps adding slabs and scaffolding.
//  - When the drawing is complete the crane carries a swaying beam along the jib, the beacon
//    blinks, loose draft planes drift, and the dashed construction guides slowly march.
//  - Reduced motion: no movement; the finished drawing is simply there.
import sketch from '../../assets/tower-sketch.svg?raw';
---

<Fragment set:html={sketch} />

<style is:global>
  .tower-sketch {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    color: #3d4a5c; /* graphite pencil */
    --accent: #c8123f; /* logo crimson, deepened for thin lines */
  }
  .tower-sketch .s,
  .tower-sketch .hk,
  .tower-sketch .guide {
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .tower-sketch .guide {
    stroke-width: 0.8;
    stroke-dasharray: 6 7;
    opacity: 0.36;
  }
  /* Accents in the logo's crimson: crane, dimension line, planes, hook + beam, beacon */
  .tower-sketch .sk--crane,
  .tower-sketch .sk--plane,
  .tower-sketch .sk--float,
  .tower-sketch .sk-hook {
    color: var(--accent);
  }
  .tower-sketch .hk {
    stroke-width: 1;
    opacity: 0.85;
  }
  .tower-sketch .sk-beacon {
    fill: #e8104c;
    opacity: 0.8;
  }

  @media all {
    /* ---- 1. Every line draws itself, in its own time ----
       pathLength="1" on each stroke: one dash = the whole line, followed by a gap of 2 so the
       pattern can never repeat onto the line itself (a plain "1" repeats every 2 and leaves
       the last few percent of a hidden line visible). Offset 1.06 = not drawn yet, a little over
       1 so the round cap of a hidden line never shows as a dot. */
    .tower-sketch .s {
      stroke-dasharray: 1 2;
      stroke-dashoffset: 1.06;
      animation:
        sk-draw var(--t, 0.8s) cubic-bezier(0.45, 0.05, 0.25, 1) var(--d, 0s) forwards,
        sk-ink 1.8s ease-out var(--d, 0s) backwards;
    }
    /* Climbing edges and mullions: constant speed, like a pen drawn steadily upwards */
    .tower-sketch .s.r {
      animation: sk-draw var(--t, 5s) linear var(--d, 0s) forwards;
    }
    /* Loose draft planes: draw in, then drift */
    .tower-sketch .s.fl {
      animation:
        sk-draw 2.6s cubic-bezier(0.45, 0.05, 0.25, 1) var(--d, 0s) forwards,
        sk-float var(--fdur, 9s) ease-in-out calc(var(--d, 0s) + 3s + var(--fdl, 0s)) infinite alternate;
    }

    /* ---- 2. Construction guides: fade in, then the dashes slowly march along the line ---- */
    .tower-sketch .guide {
      animation:
        sk-guide-in 2s ease 0.2s backwards,
        sk-march 36s linear infinite;
    }

    /* ---- 3. Crane works once it is built ---- */
    .tower-sketch .sk-hook {
      opacity: 0;
      animation:
        sk-show 1s ease var(--hs, 10s) forwards,
        sk-travel 22s ease-in-out calc(var(--hs, 10s) + 1s) infinite;
    }
    .tower-sketch .sk-beam {
      transform-box: view-box;
      transform-origin: 1303px 276px; /* swing around the hook */
      animation: sk-sway 5s ease-in-out calc(var(--hs, 10s) + 1s) infinite alternate;
    }
    .tower-sketch .sk-beacon {
      opacity: 0;
      animation: sk-blink 2.2s ease-in-out var(--bs, 9s) infinite;
    }
  }

  @keyframes sk-draw {
    to {
      stroke-dashoffset: 0;
    }
  }
  /* only a "from": every line starts in crimson (the pen tip) and settles to the graphite colour */
  @keyframes sk-ink {
    from {
      stroke: var(--accent);
    }
  }
  @keyframes sk-guide-in {
    from {
      opacity: 0;
    }
  }
  @keyframes sk-march {
    to {
      stroke-dashoffset: -130; /* 10 dash cycles (6 + 7 each) */
    }
  }
  @keyframes sk-show {
    to {
      opacity: 1;
    }
  }
  @keyframes sk-float {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(-14px);
    }
  }
  /* The trolley runs ~170 units along the jib towards the mast and back */
  @keyframes sk-travel {
    0%,
    10% {
      transform: translateX(0);
    }
    45%,
    60% {
      transform: translateX(170px);
    }
    95%,
    100% {
      transform: translateX(0);
    }
  }
  @keyframes sk-sway {
    from {
      transform: rotate(-1.6deg);
    }
    to {
      transform: rotate(1.6deg);
    }
  }
  @keyframes sk-blink {
    0%,
    100% {
      opacity: 0.15;
    }
    50% {
      opacity: 1;
    }
  }
</style>
