---
// One problem we solve: the problem, why it hurts, how Ashiyana handles it. Plain column, no card.
interface Props {
  icon?: string;
  problem: string;
  text: string;
  how: string;
}
const { problem, text, how } = Astro.props;
---

<article class="problem">
  <h3 class="heading-lg">{problem}</h3>
  <p class="problem__text">{text}</p>
  <p class="problem__how"><strong>What we do:</strong> {how}</p>
</article>

<style>
  .problem {
    padding-top: var(--s-5);
    border-top: 1px solid var(--hairline-strong);
  }
  .problem__text {
    margin-top: var(--s-2);
    color: var(--ink-secondary);
  }
  .problem__how {
    margin-top: var(--s-4);
    color: var(--ink);
  }
  strong {
    font-weight: var(--fw-heading);
  }
</style>
