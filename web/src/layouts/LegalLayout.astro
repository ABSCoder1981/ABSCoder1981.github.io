---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  h1: string;
  path: string;
  updated: string;
}
const { title, description, h1, path, updated } = Astro.props;
---

<BaseLayout title={title} description={description} pageName={`${h1} page`} crumbs={[{ name: h1, path }]} finalCta={false}>
  <article class="section legal">
    <div class="container">
      <h1 class="display-xl">{h1}</h1>
      <p class="muted updated">Last updated: {updated}</p>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</BaseLayout>

<style>
  .legal {
    padding-top: var(--s-6);
  }
  .updated {
    margin: var(--s-3) 0 var(--s-6);
    font-size: var(--fs-caption);
  }
</style>
