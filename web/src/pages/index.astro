---
import { Picture } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Mesh from '../components/Mesh.astro';
import CtaButtons from '../components/CtaButtons.astro';
import StatRow from '../components/StatRow.astro';
import TrustBand from '../components/TrustBand.astro';
import OfficeMapCard from '../components/OfficeMapCard.astro';
import SectionHead from '../components/SectionHead.astro';
import ProblemCard from '../components/ProblemCard.astro';
import ServicesOverview from '../components/ServicesOverview.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import LocalityList from '../components/LocalityList.astro';
import FeatureCard from '../components/FeatureCard.astro';
import TeamCard from '../components/TeamCard.astro';
import ReviewCard from '../components/ReviewCard.astro';
import PhotoWall from '../components/PhotoWall.astro';
import ContactBlock from '../components/ContactBlock.astro';
import Icon from '../components/Icon.astro';
import { site } from '../lib/site';
import { img } from '../lib/images';
import home from '../data/home.json';
import people from '../data/people.json';
import sanaswadi from '../data/sanaswadi.json';

const pageName = 'Home page';
const waInterest = 'buying, selling or renting a property';
const msg = people.founderMessage;
---

<BaseLayout
  classic
  title="Ashiyana Real Estate · Property Consultants in Pune"
  description="Buy, sell, rent or invest in property in Kothrud and west Pune with a family firm of 30+ years. Talk to us on WhatsApp or call 074999 14181."
  pageName={pageName}
  waInterest={waInterest}
>
  <!-- 1. Hero + stats -->
  <section class="hero" aria-labelledby="hero-h">
    <Mesh />
    <div class="container hero__grid">
      <div class="hero__text">
        <span class="eyebrow">Property consultants · Kothrud, Pune</span>
        <h1 id="hero-h" class="display-xxl">
          Find the right home, <span class="tone-mute">or the right buyer, in Pune.</span>
        </h1>
        <p class="lead">
          Resale flats, new projects and land across west Pune, handled by a Kothrud family firm from the first call to
          registration.
        </p>
        <CtaButtons pageName={pageName} waInterest={waInterest} />
        <StatRow />
      </div>
      <figure class="hero__media">
        <Picture
          src={img('wall/client-12.jpg')}
          alt="Ashiyana team handing over the keys to a family at the Kothrud office"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={720}
          height={600}
          widths={[400, 560, 720]}
          sizes="(max-width: 1023px) calc(100vw - 32px), 560px"
          fit="cover"
          loading="eager"
          fetchpriority="high"
        />
        <figcaption>A key handover at our Kothrud office</figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Trust evidence, right under the hero: developer relationships + a real client story -->
  <TrustBand />

  <!-- 3. Problems we solve -->
  <section class="section section--soft" aria-labelledby="problems-h">
    <div class="container">
      <SectionHead id="problems-h" title="Property in Pune is hard." tone="We make it simpler." />
      <div class="grid grid-3 problems">
        {home.problems.slice(0, 3).map((p) => <ProblemCard {...p} />)}
      </div>
    </div>
  </section>

  <!-- 4. Services -->
  <section class="section" aria-labelledby="services-h">
    <div class="container">
      <SectionHead
        id="services-h"
        title="Everything you need"
        tone="to buy, sell or rent."
        lead="One team for the whole journey, from the first conversation to registration and beyond."
      />
      <ServicesOverview ctaHref="#contact" />
    </div>
  </section>

  <!-- 5. How we work -->
  <section class="section section--soft" aria-labelledby="process-h">
    <div class="container">
      <div class="split">
        <SectionHead
          id="process-h"
          title="How we work:"
          tone="four steps, one team."
          lead="The same people stay with you from the first call to the registration office."
        />
        <ProcessSteps steps={home.process} layout="list" />
      </div>
    </div>
  </section>

  <!-- 6. Localities + featured project -->
  <section class="section" aria-labelledby="localities-h">
    <div class="container">
      <div class="split">
        <div class="loc-intro">
          <SectionHead
            id="localities-h"
            title="Where we know"
            tone="every street."
            lead="Our office is at Karve Statue, Kothrud. These are the west and central Pune neighbourhoods we work in every week."
          />
          <OfficeMapCard distance="Every area listed here is within about 5 km" />
        </div>
        <LocalityList columns={1} />
      </div>

      <a class="project" href="/projects/sanaswadi-industrial-land">
        <Picture
          src={img('sanaswadi/ariel_view.png')}
          alt="Aerial view of the Sanaswadi industrial plot, outlined in red"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={720}
          widths={[360, 540, 720]}
          sizes="(max-width: 1023px) 100vw, 50vw"
          loading="lazy"
          class="project__img"
        />
        <div class="project__body">
          <span class="eyebrow">Featured project · Industrial land</span>
          <h3 class="display-lg">Industrial land in Sanaswadi</h3>
          <p>A large, demarcated plot in the Sanaswadi manufacturing and logistics belt on the Pune–Nagar highway.</p>
          <dl class="project__facts">
            {
              sanaswadi.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd class="num">{f.value}</dd>
                </div>
              ))
            }
          </dl>
          <span class="text-link">View plot details <Icon name="arrow" /></span>
        </div>
      </a>
    </div>
  </section>

  <!-- 7. Why Ashiyana -->
  <section class="section section--soft" aria-labelledby="why-h">
    <div class="container">
      <SectionHead id="why-h" title="Why Ashiyana:" tone="a family firm that stays with you." />
      <div class="grid grid-3 why">
        {home.why.map((w) => <FeatureCard {...w} />)}
      </div>
    </div>
  </section>

  <!-- 8. Leadership and team -->
  <section class="section section--cream" aria-labelledby="leadership-h">
    <div class="container">
      <div class="leader">
        <Picture
          src={img('team/sattar-sayyad.png')}
          alt="Sattar Sayyad, Founder and Managing Director of Ashiyana Real Estate"
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          width={480}
          height={560}
          widths={[320, 480]}
          sizes="(max-width: 767px) 60vw, 320px"
          fit="cover"
          position="top"
          loading="lazy"
          class="leader__img"
        />
        <div>
          <span class="eyebrow">Leadership message</span>
          <h2 id="leadership-h" class="display-lg leader__quote">“{msg.quote}”</h2>
          <p class="leader__name">{msg.name}</p>
          <p class="leader__meta">{msg.role} · {msg.meta}</p>
          <a class="text-link" href="/about">Our story and team <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>
  <section class="section" aria-labelledby="team-h">
    <div class="container">
      <SectionHead id="team-h" title="The people" tone="you’ll work with." />
      <div class="grid grid-4">
        {people.team.map((m) => <TeamCard member={m} />)}
      </div>
    </div>
  </section>

  <!-- 9. Client reviews -->
  <section class="section section--soft" aria-labelledby="reviews-h">
    <div class="container">
      <SectionHead id="reviews-h" title="More from" tone="our clients." />
      <div class="grid grid-2">
        {people.reviews.slice(1).map((r) => <ReviewCard review={r} />)}
      </div>
    </div>
  </section>

  <!-- 10. Wall of Happiness -->
  <section class="section" aria-labelledby="wall-h">
    <div class="container">
      <SectionHead id="wall-h" title={`Wall of Happiness:`} tone={`a few of our ${site.stats.clients} clients.`} />
      <PhotoWall />
    </div>
  </section>

  <!-- 11. Contact -->
  <section class="section section--soft" id="contact" aria-labelledby="contact-h">
    <div class="container">
      <ContactBlock pageName={pageName} waInterest={waInterest} />
    </div>
  </section>
  <!-- 12. Final CTA band is rendered by the layout -->
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: var(--s-8) var(--s-9);
  }
  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: var(--s-8);
    align-items: center;
  }
  .hero h1 {
    max-width: 15ch;
  }
  .hero .lead {
    margin-top: var(--s-5);
    max-width: 46ch;
  }
  .hero :global(.btn-row) {
    margin-top: var(--s-6);
  }
  .hero :global(.stats) {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--hairline);
  }
  .hero__media {
    margin: 0;
  }
  .hero__media :global(img) {
    width: 100%;
    aspect-ratio: 6 / 5;
    object-fit: cover;
    border-radius: var(--r-hero);
    background: var(--canvas-soft);
  }
  .hero__media figcaption {
    margin-top: var(--s-2);
    font-size: var(--fs-caption);
    color: var(--ink-mute);
  }
  @media (max-width: 1023px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-6);
    }
    .hero__media :global(img) {
      aspect-ratio: 4 / 3;
    }
  }
  @media (max-width: 767px) {
    .hero {
      padding-block: var(--s-6) var(--s-8);
    }
  }

  .loc-intro {
    display: grid;
    gap: var(--s-6);
    position: sticky;
    top: calc(var(--header-h) + var(--s-6));
  }
  .loc-intro :global(.section-head) {
    margin-bottom: 0;
  }
  @media (max-width: 1023px) {
    .loc-intro {
      position: static;
    }
  }
  .problems {
    gap: var(--s-6);
  }
  .why {
    gap: var(--s-6);
  }

  .project {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    margin-top: var(--s-8);
    overflow: hidden;
    border-radius: var(--r-hero);
    background: var(--brand-dark);
    color: #e7eef7;
    text-decoration: none !important;
  }
  .project :global(picture) {
    height: 100%;
  }
  .project :global(.project__img) {
    width: 100%;
    height: 100%;
    min-height: 280px;
    object-fit: cover;
  }
  .project__body {
    padding: var(--s-7);
  }
  .project .eyebrow {
    color: #f3c2cf;
  }
  .project h3 {
    color: #fff;
  }
  .project p {
    margin-top: var(--s-3);
    color: #ecd3da;
  }
  .project__facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--s-4);
    margin: var(--s-5) 0;
  }
  .project__facts dt {
    font-size: var(--fs-label);
    color: #d9a9b6;
  }
  .project__facts dd {
    font-size: var(--fs-card);
    font-weight: var(--fw-heading);
    color: #fff;
  }
  .project .text-link {
    color: #fff;
  }
  @media (max-width: 1023px) {
    .project {
      grid-template-columns: minmax(0, 1fr);
    }
    .project__body {
      padding: var(--s-5);
    }
  }

  .leader {
    display: grid;
    grid-template-columns: 300px minmax(0, 1fr);
    gap: var(--s-8);
    align-items: center;
  }
  .leader :global(.leader__img) {
    width: 100%;
    aspect-ratio: 6 / 7;
    object-fit: cover;
    object-position: top;
    border-radius: var(--r-card-lg);
  }
  .leader__quote {
    max-width: 32ch;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.875rem);
    line-height: 1.3;
  }
  .leader__name {
    margin-top: var(--s-5);
    font-weight: var(--fw-heading);
  }
  .leader__meta {
    color: var(--ink-secondary);
    font-size: var(--fs-body-sm);
    margin-bottom: var(--s-2);
  }
  @media (max-width: 767px) {
    .leader {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--s-5);
    }
    .leader :global(.leader__img) {
      max-width: 220px;
    }
  }
</style>
