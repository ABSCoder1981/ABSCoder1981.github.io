# Enquiry API settings. On the VPS these live in /etc/ashiyana-api.env (root-owned, mode 600).
# Locally, copy to api/.env. Without SMTP_HOST (and NODE_ENV not production) emails are only logged.

PORT=8787
HOST=127.0.0.1

# Where enquiries go, and who they come from (the sender domain needs SPF + DKIM set up)
MAIL_TO=infoashiyanarealestate@gmail.com
MAIL_FROM="Ashiyana Website <website@ashiyanarealestate.in>"

# SMTP — e.g. Zoho Mail (smtp.zoho.in, 465, secure) or Brevo (smtp-relay.brevo.com, 587, STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

SITE_URL=https://www.ashiyanarealestate.in
# Enquiries per IP per hour (PRD: 5)
RATE_LIMIT_MAX=5
# Behind Nginx on the same machine: trust its X-Forwarded-For
TRUST_PROXY=127.0.0.1
LOG_LEVEL=info
